# Read from the process environment (export them); twin does not load .env files.
# Required for replay, bisect and gc. capture and inspect need nothing.
SOLARI_API_KEY=slr_live_...
# Optional: gateway override, defaults to https://api.getsolari.com
SOLARI_BASE_URL=
# Optional: set to any value to disable colored output (https://no-color.org)
NO_COLOR=
