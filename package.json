{
  "name": "twin",
  "version": "0.1.0",
  "private": true,
  "description": "Capture a failing environment on one machine, replay it on a Solari sandbox, and find the difference that breaks it.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "twin": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node src/bin.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "e2e:docker": "node test/e2e/replay-docker.ts",
    "e2e:docker:bisect": "node test/e2e/bisect-docker.ts"
  },
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@solarisdk/sdk": "0.1.4"
  }
}
