// Records the real twin website (served locally) as 30 fps frames with eased scrolling, zooms and
// clicks. Chrome runs under virtual time: every frame advances the page clock by exactly 1/30 s,
// so the site's own animations play at their real speed and the camera is deterministic.
//
// usage: node site-record.mjs <outDir> [baseUrl=http://127.0.0.1:4321/twin] [--only <n frames>]
import { mkdirSync, rmSync, writeFileSync } from 'node:fs';
import { launch, sleep } from './cdp.mjs';

const [out, base = 'http://127.0.0.1:4321/twin'] = process.argv.slice(2);
const only = process.argv.includes('--only') ? Number(process.argv[process.argv.indexOf('--only') + 1]) : Infinity;
const W = 1500;
const H = 820;
const FPS = 30;
const DT = 1000 / FPS;
rmSync(out, { recursive: true, force: true });
mkdirSync(out, { recursive: true });

const c = await launch({ port: 9950 + Math.floor(Math.random() * 40), profile: `${out}/.profile`, width: W, height: H });
const { send, ev } = c;
await send('Page.enable');
await send('Emulation.setDeviceMetricsOverride', { width: W, height: H, deviceScaleFactor: 1, mobile: false });
await send('Emulation.setEmulatedMedia', { features: [{ name: 'prefers-color-scheme', value: 'light' }] });
await send('Browser.grantPermissions', { permissions: ['clipboardReadWrite', 'clipboardSanitizedWrite'], origin: new URL(base).origin });
await send('Page.addScriptToEvaluateOnNewDocument', {
  source: `
  try { localStorage.setItem('starlight-theme', 'light'); } catch {}
  document.addEventListener('DOMContentLoaded', () => {
    const st = document.createElement('style');
    st.textContent = 'html{scroll-behavior:auto !important} #__cur{position:fixed;left:0;top:0;width:34px;height:34px;margin:-17px 0 0 -17px;border:2px solid #2f5bd3;border-radius:50%;background:rgba(47,91,211,.14);pointer-events:none;z-index:2147483647;opacity:0;will-change:transform}';
    document.head.appendChild(st);
    const d = document.createElement('div'); d.id = '__cur'; document.body.appendChild(d);
  });`,
});

let waiter = null;
c.on((m) => { if (m.method === 'Emulation.virtualTimeBudgetExpired' && waiter) { waiter(); waiter = null; } });
const advance = async (ms) => {
  for (let attempt = 0; attempt < 4; attempt++) {
    const p = new Promise((r) => (waiter = r));
    await send('Emulation.setVirtualTimePolicy', { policy: 'pauseIfNetworkFetchesPending', budget: ms });
    const ok = await Promise.race([p.then(() => true), sleep(6000).then(() => false)]);
    if (ok) return;
    console.log('advance timeout at frame', n, 'retry', attempt);
  }
};

// camera + cursor state
const cam = { scroll: 0, z: 1, cx: W / 2, cy: H / 2 };
const cur = { x: -100, y: -100, on: 0, s: 1 };
const log = { captions: [], urls: [], zooms: [], clicks: [] };
let n = 0;
let url = base + '/';
const beat = (t) => console.log('beat', t, 'frame', n);
const ease = (p) => (p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2);
const easeOut = (p) => 1 - Math.pow(1 - p, 3);

async function frame() {
  const dbg = n > 1028 ? (m) => console.log(n, m) : () => {};
  dbg('advance');
  await advance(DT);
  dbg('advanced');
  if (n >= only) return;
  const z = cam.z;
  const w = W / z;
  const h = H / z;
  const x = Math.min(Math.max(cam.cx - w / 2, 0), W - w);
  const y = Math.min(Math.max(cam.cy - h / 2, 0), H - h);
  const sy = await ev(`window.scrollTo(0, ${cam.scroll}); (()=>{const d=document.getElementById('__cur'); if(d){d.style.opacity=${cur.on}; d.style.transform='translate(${cur.x}px,${cur.y}px) scale(${cur.s})';}})(); window.scrollY`);
  dbg('eval done');
  const r = await send('Page.captureScreenshot', {
    format: 'jpeg', quality: 93,
    clip: { x, y: sy + y, width: w, height: h, scale: z },
  });
  dbg('shot done');
  n++;
  writeFileSync(`${out}/${String(n).padStart(5, '0')}.jpg`, Buffer.from(r.result.data, 'base64'));
}
const tween = async (sec, fn, easing = ease) => {
  const k = Math.max(1, Math.round(sec * FPS));
  for (let i = 1; i <= k; i++) { fn(easing(i / k)); await frame(); }
};
const hold = async (sec) => { for (let i = 0; i < Math.round(sec * FPS); i++) await frame(); };
const cap = (text) => log.captions.push({ f: n, text });
const rectOf = async (sel) => JSON.parse(await ev(`(()=>{const e=document.querySelector(${JSON.stringify(sel)}); if(!e) return 'null'; const r=e.getBoundingClientRect(); return JSON.stringify({x:r.left,y:r.top,w:r.width,h:r.height,pageY:r.top+scrollY});})()`));
const scrollToY = async (target, sec) => {
  const max = (await ev('document.documentElement.scrollHeight')) - H;
  const from = cam.scroll; const to = Math.max(0, Math.min(max, target));
  await tween(sec, (p) => { cam.scroll = from + (to - from) * p; });
};
const scrollTo = async (sel, sec, top = 90) => {
  const r = await rectOf(sel);
  await scrollToY(r.pageY - top, sec);
};
const zoomTo = async (rect, label, sec = 0.4, pad = 40, maxZ = 2.4) => {
  const z = Math.min(maxZ, W / (rect.w + 2 * pad), H / (rect.h + 2 * pad));
  const from = { ...cam };
  const tcx = rect.x + rect.w / 2; const tcy = rect.y + rect.h / 2;
  log.zooms.push({ f0: n, label });
  await tween(sec, (p) => {
    cam.z = from.z + (z - from.z) * p;
    cam.cx = from.cx + (tcx - from.cx) * p;
    cam.cy = from.cy + (tcy - from.cy) * p;
  });
};
const zoomOut = async (sec = 0.4) => {
  const from = { ...cam };
  await tween(sec, (p) => {
    cam.z = from.z + (1 - from.z) * p;
    cam.cx = from.cx + (W / 2 - from.cx) * p;
    cam.cy = from.cy + (H / 2 - from.cy) * p;
  });
  if (log.zooms.length) log.zooms[log.zooms.length - 1].f1 = n;
};
const moveTo = async (x, y, sec = 0.45) => {
  if (!cur.on) { cur.x = x + 120; cur.y = y + 90; cur.on = 1; }
  const from = { x: cur.x, y: cur.y };
  await tween(sec, (p) => { cur.x = from.x + (x - from.x) * p; cur.y = from.y + (y - from.y) * p; });
};
const click = async (sel, { after = 0.25 } = {}) => {
  const r = await rectOf(sel);
  await moveTo(r.x + r.w / 2, r.y + r.h / 2);
  log.clicks.push({ f: n, sel });
  await tween(0.12, (p) => { cur.s = 1 - 0.35 * p; }, (p) => p);
  await ev(`document.querySelector(${JSON.stringify(sel)}).click()`);
  await tween(0.14, (p) => { cur.s = 0.65 + 0.35 * p; }, (p) => p);
  await hold(after);
};
const hideCursor = () => { cur.on = 0; };
const navigate = async (to) => {
  url = to;
  await send('Page.navigate', { url: to });
  await advance(1200);
  cam.scroll = 0; cam.z = 1; cam.cx = W / 2; cam.cy = H / 2;
  log.urls.push({ f: n, url: to });
};

// ---- choreography ----
await send('Emulation.setVirtualTimePolicy', { policy: 'pause' });
await navigate(base + '/');
await advance(300);

cap('The twin site: install, the ten commands, and a real bug worked end to end.');
await hold(3.0); // the hero terminal types itself

cap('Install with one command. Copy it in one click.');
const inst = await rectOf('.install');
await zoomTo(inst, 'install', 0.4, 110, 2.2);
await click('.copy', { after: 0.5 });
await hold(1.6); // the button reads "Copied"
await zoomOut();
hideCursor();

cap('Ten commands, one file between them.');
await scrollTo('#commands', 1.0, 70);
await hold(2.0);

cap('A real bug: the capsule shows what it kept, value recorded, name only or not set.');
await scrollTo('[data-demo=capture]', 1.2, 130);
await hold(1.2);
await click('[data-demo=capture] .tabs button[data-group=environment]', { after: 0.4 });
const capsule = await rectOf('[data-demo=capture] .capsule');
await zoomTo(capsule, 'privacy', 0.4, 30, 1.9);
await hold(2.8);
await zoomOut();
hideCursor();

cap('Replay rebuilds the environment on a Solari machine.');
await scrollTo('[data-demo=stream]', 1.1, 130);
await hold(2.4);

cap('Bisect narrows the difference in stages: compare, trial 1, trial 2, result.');
await scrollTo('[data-demo=bisect]', 1.2, 110);
await hold(0.8);
const bis = await rectOf('[data-demo=bisect]');
await zoomTo({ ...bis, h: 470 }, 'bisect', 0.4, 20, 1.6);
for (let i = 1; i <= 4; i++) {
  await click(`[data-demo=bisect] .tabs button[data-stage="${i}"]`, { after: 0.95 });
}
await zoomOut();
hideCursor();

cap('Verify checks the fix in the environment where the bug was reported.');
const verifyRect = await rectOf('ol.steps > li.pair:last-child');
await scrollToY((verifyRect ? verifyRect.pageY : cam.scroll + 900) - 120, 1.1);
await hold(2.2);

beat('agents'); cap('Agents get the reporter’s machine over MCP.');
await scrollTo('[data-demo=agents]', 1.3, 110);
await hold(0.8);
const tl = await rectOf('[data-demo=agents] .timeline');
await zoomTo(tl, 'agents', 0.4, 50, 1.9);
await click('[data-demo=agents] .call[data-i="2"] button', { after: 0.4 }).catch(() => {});
await hold(2.4);
await zoomOut();
hideCursor();

cap('What a capsule holds, where twin fits, and its limits.');
await scrollTo('#files', 1.1, 70);
await hold(1.3);
await scrollTo('#see-also', 1.2, 70);
await hold(0.8);
await scrollTo('#limits', 1.2, 70);
await hold(0.8);
await scrollToY(99999, 1.2);
await hold(1.0);

cap('Guides and a CLI reference cover every command.');
await navigate(base + '/guides/replay/');
await hold(1.8);
await scrollToY(420, 1.4);
await hold(1.2);

log.frames = n;
writeFileSync(`${out}/site.json`, JSON.stringify({ W, H, FPS, ...log, base }, null, 1));
console.log('frames', n, 'seconds', (n / FPS).toFixed(1), JSON.stringify(log.zooms));
c.close();
