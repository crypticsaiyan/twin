---
/** A shell command with a copy button. Falls back to selecting the text if the clipboard is unavailable. */
interface Props {
  command: string;
  label?: string;
  prompt?: string;
  size?: 'lg' | 'md';
}

const { command, label = 'Copy command', prompt = '$', size = 'md' } = Astro.props;
---

<div class:list={['copy', `copy-${size}`]} data-copy>
  <code
    ><span class="prompt" aria-hidden="true">{prompt}</span><span class="text" data-copy-text
      >{command}</span
    ></code
  >
  <button type="button" data-copy-button aria-label={label}>
    <svg class="i-copy" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
      <rect x="5" y="5" width="8.5" height="8.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"
      ></rect>
      <path
        d="M10.5 3.2A1.7 1.7 0 0 0 9 2.5H4.2a1.7 1.7 0 0 0-1.7 1.7V9a1.7 1.7 0 0 0 .7 1.4"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"></path>
    </svg>
    <svg class="i-done" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
      <path
        d="M3 8.5l3 3 7-7"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>
  <span class="status" role="status" data-copy-status></span>
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-copy]')) {
    const button = box.querySelector<HTMLButtonElement>('[data-copy-button]');
    const text = box.querySelector<HTMLElement>('[data-copy-text]');
    const status = box.querySelector<HTMLElement>('[data-copy-status]');
    let timer: number | undefined;
    button?.addEventListener('click', async () => {
      if (!text || !status) return;
      try {
        await navigator.clipboard.writeText(text.textContent ?? '');
        box.dataset.copied = '';
        status.textContent = 'Copied to clipboard';
      } catch {
        const range = document.createRange();
        range.selectNodeContents(text);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        status.textContent = 'Selected, press Ctrl+C to copy';
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        delete box.dataset.copied;
        status.textContent = '';
      }, 1800);
    });
  }
</script>

<style>
  .copy {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
    padding: 0.375rem 0.375rem 0.375rem 1rem;
    background: var(--twin-surface);
    border: 1px solid var(--twin-border);
    border-radius: 12px;
    box-shadow: var(--twin-shadow);
  }

  code {
    flex: 1;
    min-width: 0;
    font: 500 0.875rem/1.5 var(--twin-font-mono);
    color: var(--twin-text);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    padding: 0.25rem 0;
  }

  .copy-lg code {
    font-size: 0.9375rem;
  }

  .prompt {
    color: var(--twin-accent);
    margin-right: 0.6em;
    user-select: none;
  }

  button {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--twin-border);
    border-radius: 9px;
    background: var(--twin-surface-2);
    color: var(--twin-text-muted);
    cursor: pointer;
    transition:
      color 150ms,
      border-color 150ms;
  }

  button:hover {
    color: var(--twin-text);
    border-color: var(--twin-border-strong);
  }

  button:focus-visible {
    outline: none;
    box-shadow: var(--twin-focus);
  }

  .i-done,
  [data-copied] .i-copy {
    display: none;
  }

  [data-copied] .i-done {
    display: block;
    color: var(--twin-pass);
  }

  .status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
