---
/**
 * The recorded MCP session from examples/echarts-21538/mcp.txt, as a timeline.
 * Every call, duration and result line is taken verbatim from the transcript at build time.
 */
import mcpTxt from '../../../examples/echarts-21538/mcp.txt?raw';
import { REPO } from '../site';

interface Call {
  tool: string;
  args: string;
  took: string;
  result: string;
  tone: 'ok' | 'hot' | 'bad' | 'dim';
}

const KEY = /^(REPRODUCED|FIXED):|✕|^wrote |^Tests:|^result /;

const calls: Call[] = mcpTxt
  .split(/^>>> /m)
  .slice(1)
  .map((block) => {
    const lines = block.split('\n');
    const [tool, ...rest] = lines[0].split(' ');
    const took = lines.find((l) => l.startsWith('<<< '))?.slice(4) ?? '';
    const result = lines.map((l) => l.trim()).find((l) => KEY.test(l)) ?? '';
    const tone = /^FIXED|passed/.test(result)
      ? 'ok'
      : /^REPRODUCED/.test(result)
        ? 'hot'
        : /✕|FAIL|failed/.test(result)
          ? 'bad'
          : 'dim';
    return { tool, args: rest.join(' '), took, result, tone };
  });

const total = mcpTxt.match(/^session (\d+ s)$/m)?.[1] ?? '';
---

<section class="session" aria-labelledby="session-title">
  <header>
    <p class="label">Recorded agent session</p>
    <h3 id="session-title">From capsule to verified fix in {total}, driven only through MCP.</h3>
    <p>
      A scripted MCP client driving <code>twin mcp</code> on apache/echarts#21538: it replays the
      failure, runs the test on the kept machine, writes a patch, checks it there, verifies it on a
      fresh machine and releases the first one. Every call and result shown is verbatim.
    </p>
    <a class="link" href={`${REPO}/blob/main/examples/echarts-21538/mcp.txt`}
      >Full transcript <span aria-hidden="true">→</span></a
    >
  </header>
  <ol class="timeline">
    {
      calls.map((c) => (
        <li class={`call tone-${c.tone}`}>
          <div class="call-head">
            <code class="tool">{c.tool}</code>
            <span class="took">{c.took}</span>
          </div>
          <code class="args">{c.args}</code>
          {c.result && <code class="result">{c.result}</code>}
        </li>
      ))
    }
  </ol>
</section>

<style>
  .session {
    display: grid;
    gap: 1.5rem 2.5rem;
    margin-top: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--twin-term-border);
    border-radius: var(--twin-radius);
    background: var(--twin-term-bg);
    color: var(--twin-term-text);
  }

  @media (min-width: 960px) {
    .session {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }

  header {
    min-width: 0;
  }

  .label {
    color: var(--twin-term-orange);
    font: 600 0.75rem/1 var(--twin-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0.75rem 0;
    color: #ffffff;
    font-family: var(--twin-font-display);
    font-size: 1.45rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  header p {
    color: var(--twin-term-muted);
    font-size: 0.9375rem;
  }

  header p code {
    color: var(--twin-term-text);
    font-size: 0.85em;
  }

  .link {
    display: inline-block;
    margin-top: 1rem;
    color: var(--twin-term-orange);
    font-weight: 600;
    text-decoration: none;
  }

  .link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .link:focus-visible {
    outline-color: var(--twin-term-orange);
  }

  .timeline {
    min-width: 0;
    padding: 0;
    list-style: none;
  }

  .call {
    position: relative;
    display: grid;
    gap: 0.2rem;
    padding: 0 0 1rem 1.5rem;
    min-width: 0;
  }

  .call::before {
    content: '';
    position: absolute;
    left: 0.28rem;
    top: 0.9rem;
    bottom: -0.1rem;
    width: 1px;
    background: #ffffff1f;
  }

  .call:last-child {
    padding-bottom: 0;
  }

  .call:last-child::before {
    display: none;
  }

  .call::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0.4rem;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--twin-term-bg);
    box-shadow: inset 0 0 0 2px var(--dot, #5b616b);
  }

  .tone-ok {
    --dot: var(--twin-term-green);
  }

  .tone-hot {
    --dot: var(--twin-term-orange);
  }

  .tone-bad {
    --dot: var(--twin-term-red);
  }

  .call-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  code {
    font-family: var(--twin-font-mono);
  }

  .tool {
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .took {
    color: var(--twin-term-muted);
    font: 500 0.75rem/1 var(--twin-font-mono);
  }

  .args {
    color: var(--twin-term-muted);
    font-size: 0.72rem;
    overflow-wrap: anywhere;
  }

  .result {
    font-size: 0.78rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .tone-ok .result {
    color: var(--twin-term-green);
  }

  .tone-hot .result {
    color: var(--twin-term-orange);
  }

  .tone-bad .result {
    color: var(--twin-term-red);
  }
</style>
