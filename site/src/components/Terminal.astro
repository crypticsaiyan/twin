---
/**
 * Replays the recorded Solari runs from examples/echarts-21538 as a typed terminal.
 * The transcripts are read from the repo at build time, so the page never drifts from them.
 * Without JS, or with reduced motion, every line is shown at once.
 */
import bisectTxt from '../../../examples/echarts-21538/bisect.txt?raw';
import replayTxt from '../../../examples/echarts-21538/replay.txt?raw';
import verifyTxt from '../../../examples/echarts-21538/verify.txt?raw';
import { EXAMPLE } from '../site';

interface Run {
  id: string;
  label: string;
  time: string;
  command: string;
  text: string;
}

const runs: Run[] = [
  { id: 'replay', label: 'replay', time: '72 s', command: 'twin replay new-york.json', text: replayTxt },
  {
    id: 'bisect',
    label: 'bisect',
    time: '69 s',
    command: 'twin bisect new-york.json --good kolkata.json',
    text: bisectTxt,
  },
  {
    id: 'verify',
    label: 'verify',
    time: '71 s',
    command: 'twin verify new-york.json --patch fix.patch',
    text: verifyTxt,
  },
];

const escape = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

const VERDICT = /^(REPRODUCED|FIXED|NOT REPRODUCED|STILL FAILING|DIFFERENT FAILURE|FLAKY|INCONCLUSIVE):/;
const TOKEN = /(✓)|\b(FAIL)\b|\b(PASS|pass)\b|(exit1:[0-9a-f]{16})|(TZ=[\w/]+)|(\d+(?:\.\d+)?s)$/g;

/** Color one transcript line. Works on the raw text so inserted markup is never re-matched. */
function paint(line: string): string {
  const verdict = line.match(VERDICT);
  if (verdict) {
    const word = verdict[1];
    const tone = word === 'FIXED' ? 'ok' : 'hot';
    return `<span class="t-verdict t-${tone}">${word}</span>${escape(line.slice(word.length))}`;
  }
  let out = '';
  let last = 0;
  for (const m of line.matchAll(TOKEN)) {
    out += escape(line.slice(last, m.index));
    const [text, check, fail, pass, sig, tz] = m;
    const cls = check || pass ? 't-ok' : fail ? 't-bad' : sig ? 't-sig' : tz ? 't-hot' : 't-dim';
    out += `<span class="${cls}">${escape(text)}</span>`;
    last = (m.index ?? 0) + text.length;
  }
  out += escape(line.slice(last));
  const isHeading = line.length > 0 && !line.startsWith(' ');
  return isHeading ? `<span class="t-head">${out}</span>` : out;
}

/** How long to wait before a line appears, roughly following the real run. */
function waitFor(line: string): number {
  if (/npm ci|environment built/.test(line)) return 1300;
  if (line.includes('✓')) return 200;
  if (/^\s+\d+\s+(FAIL|PASS|pass)\b/.test(line)) return 650;
  if (VERDICT.test(line) || line.startsWith('Minimal')) return 700;
  return line.trim() === '' ? 60 : 90;
}

const panels = runs.map((run) => {
  const lines = run.text.replace(/\s+$/, '').split('\n');
  const body = lines
    .map((l) => `<span class="ln" data-wait="${waitFor(l)}">${paint(l) || ' '}</span>`)
    .join('');
  const cmd = `<span class="ln ln-cmd"><span class="t-ps1" aria-hidden="true">$ </span><span class="cmd-text" data-text="${escape(run.command)}">${escape(run.command)}</span></span>`;
  const prompt = `<span class="ln ln-end" data-wait="500" aria-hidden="true"><span class="t-ps1">$ </span><span class="caret"></span></span>`;
  return { ...run, html: cmd + body + prompt };
});
---

<figure class="term-wrap">
  <div class="term" data-term>
    <div class="term-bar">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <div class="tabs" role="tablist" aria-label="Recorded runs on apache/echarts#21538">
        {
          panels.map((p, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${p.id}`}
              aria-controls={`panel-${p.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              <span class="tab-name">{p.label}</span>
              <span class="tab-time">{p.time}</span>
            </button>
          ))
        }
      </div>
      <button type="button" class="again" data-again aria-label="Play this run again">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path
            d="M13.5 8a5.5 5.5 0 1 1-1.6-3.9M13.5 2.5v3h-3"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
    <div class="term-body">
      {
        panels.map((p, i) => (
          <div
            class="panel"
            role="tabpanel"
            id={`panel-${p.id}`}
            aria-labelledby={`tab-${p.id}`}
            data-active={i === 0 ? 'true' : 'false'}
            tabindex="0"
          >
            <pre set:html={p.html} />
          </div>
        ))
      }
    </div>
  </div>
  <figcaption>
    Real output from Solari runs on <a href="https://github.com/apache/echarts/issues/21538"
      >apache/echarts#21538</a
    >, recorded 2026-09-28, played back faster. <a href={EXAMPLE}>Full transcripts</a>.
  </figcaption>
</figure>

<script>
  const root = document.querySelector<HTMLElement>('[data-term]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    let current = 0;
    let token = 0;
    let auto = true;

    const select = (i: number, focus = false) => {
      current = i;
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(j === i));
        t.tabIndex = j === i ? 0 : -1;
      });
      panels.forEach((p, j) => {
        p.dataset.active = String(j === i);
      });
      if (focus) tabs[i].focus();
    };

    const showAll = (panel: HTMLElement) => {
      for (const l of panel.querySelectorAll('.ln')) l.classList.add('on');
      const cmd = panel.querySelector<HTMLElement>('.cmd-text');
      if (cmd) cmd.textContent = cmd.dataset.text ?? '';
    };

    const play = async (i: number) => {
      const my = ++token;
      const panel = panels[i];
      if (reduce.matches) {
        delete root.dataset.anim;
        showAll(panel);
        return;
      }
      root.dataset.anim = '';
      const lines = [...panel.querySelectorAll<HTMLElement>('.ln')];
      for (const l of lines) l.classList.remove('on');
      const cmd = panel.querySelector<HTMLElement>('.cmd-text');
      const full = cmd?.dataset.text ?? '';
      if (cmd) cmd.textContent = '';
      lines[0].classList.add('on', 'typing');
      await wait(350);
      for (let c = 1; c <= full.length; c++) {
        if (my !== token) return;
        if (cmd) cmd.textContent = full.slice(0, c);
        await wait(22 + Math.random() * 38);
      }
      lines[0].classList.remove('typing');
      await wait(250);
      for (const l of lines.slice(1)) {
        await wait(Number(l.dataset.wait ?? 80));
        if (my !== token) return;
        l.classList.add('on');
      }
      // Walk through all three runs once, ending on verify's FIXED.
      if (auto && i < panels.length - 1) {
        await wait(3200);
        if (my !== token || !auto) return;
        select(i + 1);
        play(i + 1);
      }
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        auto = false;
        select(i);
        play(i);
      });
      tab.addEventListener('keydown', (e) => {
        const keys: Record<string, number> = {
          ArrowRight: (i + 1) % tabs.length,
          ArrowLeft: (i - 1 + tabs.length) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        };
        if (e.key in keys) {
          e.preventDefault();
          auto = false;
          select(keys[e.key], true);
          play(keys[e.key]);
        }
      });
    });

    root.querySelector('[data-again]')?.addEventListener('click', () => {
      auto = false;
      play(current);
    });

    reduce.addEventListener('change', () => {
      if (reduce.matches) {
        token++;
        delete root.dataset.anim;
        for (const p of panels) showAll(p);
      }
    });

    if (!reduce.matches) {
      // Hide lines up front so nothing flashes before the run starts.
      root.dataset.anim = '';
      panels[0].querySelector('.ln')?.classList.add('on');
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            play(0);
          }
        },
        { threshold: 0.25 },
      );
      io.observe(root);
    }
  }
</script>

<style>
  .term-wrap {
    margin: 0;
    min-width: 0;
  }

  .term {
    position: relative;
    background: var(--twin-term-bg);
    color: var(--twin-term-text);
    border: 1px solid var(--twin-term-border);
    border-radius: var(--twin-radius);
    box-shadow:
      0 30px 80px -30px light-dark(#3b1c0a55, #000000),
      0 0 0 1px #ffffff08 inset;
    overflow: hidden;
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.625rem 0.5rem 0.875rem;
    background: var(--twin-term-bar);
    border-bottom: 1px solid #ffffff10;
  }

  .dots {
    display: flex;
    gap: 6px;
    flex: none;
  }

  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #3a3f48;
  }

  .tabs {
    display: flex;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  [role='tab'] {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid transparent;
    border-radius: 7px;
    background: transparent;
    color: var(--twin-term-muted);
    font: 500 0.8125rem/1 var(--twin-font-mono);
    cursor: pointer;
    white-space: nowrap;
  }

  [role='tab']:hover {
    color: var(--twin-term-text);
  }

  [role='tab'][aria-selected='true'] {
    color: var(--twin-term-text);
    background: #ffffff0d;
    border-color: #ffffff14;
  }

  .tab-time {
    font-size: 0.6875rem;
    color: var(--twin-term-orange);
  }

  [role='tab']:focus-visible,
  .again:focus-visible,
  .panel:focus-visible {
    outline: 2px solid var(--twin-term-orange);
    outline-offset: 1px;
  }

  .panel:focus-visible {
    outline-offset: -4px;
  }

  .again {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--twin-term-muted);
    cursor: pointer;
  }

  .again:hover {
    color: var(--twin-term-text);
    background: #ffffff0d;
  }

  .term-body {
    display: grid;
  }

  .panel {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .panel[data-active='false'] {
    visibility: hidden;
  }

  pre {
    margin: 0;
    padding: 1rem 1.125rem 1.25rem;
    font: 400 0.8125rem/1.6 var(--twin-font-mono);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    tab-size: 2;
  }

  pre :global(.ln) {
    display: block;
    min-height: 1.6em;
  }

  [data-anim] pre :global(.ln) {
    opacity: 0;
    transform: translateY(3px);
  }

  [data-anim] pre :global(.ln.on) {
    opacity: 1;
    transform: none;
    transition:
      opacity 180ms ease-out,
      transform 180ms ease-out;
  }

  pre :global(.t-ps1) {
    color: var(--twin-term-orange);
    user-select: none;
  }

  pre :global(.ln-cmd) {
    color: #ffffff;
    font-weight: 600;
  }

  pre :global(.ln-cmd.typing)::after,
  pre :global(.caret) {
    content: '';
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    vertical-align: -0.2em;
    margin-left: 1px;
    background: var(--twin-term-orange);
    animation: blink 1s steps(1) infinite;
  }

  pre :global(.t-head) {
    color: #ffffff;
    font-weight: 600;
  }

  pre :global(.t-dim) {
    color: var(--twin-term-muted);
    font-weight: 400;
  }

  pre :global(.t-ok) {
    color: var(--twin-term-green);
  }

  pre :global(.t-bad) {
    color: var(--twin-term-red);
  }

  pre :global(.t-sig) {
    color: var(--twin-term-blue);
  }

  pre :global(.t-hot) {
    color: var(--twin-term-orange);
    font-weight: 600;
  }

  pre :global(.t-verdict) {
    display: inline-block;
    padding: 0 0.4em;
    border-radius: 4px;
    font-weight: 700;
    color: #0a0c0f;
  }

  pre :global(.t-verdict.t-ok) {
    background: var(--twin-term-green);
  }

  pre :global(.t-verdict.t-hot) {
    background: var(--twin-term-orange);
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--twin-text-muted);
  }

  figcaption a {
    color: inherit;
    text-underline-offset: 2px;
  }

  figcaption a:hover {
    color: var(--twin-text);
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 520px) {
    pre {
      font-size: 0.71875rem;
      padding: 0.875rem 0.875rem 1rem;
    }

    .dots,
    .tab-time {
      display: none;
    }

    [role='tab'] {
      padding-inline: 0.55rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    pre :global(.caret) {
      animation: none;
    }
  }
</style>
