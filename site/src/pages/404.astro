---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import { link } from '../site';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Not found · twin</title>
    <link rel="icon" href={link('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('starlight-theme');
        } catch {}
        const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme =
          stored === 'light' || stored === 'dark' ? stored : dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <main>
      <p class="code">404</p>
      <h1>Cannot reproduce.</h1>
      <p>There is no page at this address.</p>
      <p><a href={link('')}>Home</a> · <a href={link('start/introduction/')}>Docs</a></p>
    </main>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    background: var(--twin-bg);
    color: var(--twin-text);
    font: 400 1.0625rem/1.6 var(--twin-font-body);
  }

  main {
    max-width: 40rem;
    margin: 0 auto;
    padding: 6rem 1.25rem;
  }

  .code {
    font: 500 0.95rem var(--twin-font-mono);
    color: var(--twin-accent);
    margin: 0;
  }

  h1 {
    font-weight: 600;
    font-size: 2rem;
    margin: 0.5rem 0 1rem;
  }

  a {
    color: inherit;
    text-underline-offset: 0.18em;
  }
</style>
