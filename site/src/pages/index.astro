---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/400-italic.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import bisectLog from '../../../examples/echarts-21538/bisect.txt?raw';
import mcpLog from '../../../examples/echarts-21538/mcp.txt?raw';
import replayLog from '../../../examples/echarts-21538/replay.txt?raw';
import verifyLog from '../../../examples/echarts-21538/verify.txt?raw';
import { EXAMPLE, ISSUE, link, REPO, SOLARI } from '../site';

const title = 'twin: reproduce bugs in the reporter’s environment';
const description =
  'twin records the environment a command failed in, rebuilds it on a clean Solari sandbox, finds the difference that causes the failure, and checks a fix there.';
const canonical = new URL(link(''), Astro.site).href;
const install = 'npx github:crypticsaiyan/twin capture -- npm test';

const docs = {
  intro: link('start/introduction/'),
  quickstart: link('start/quickstart/'),
  agents: link('guides/ai-agents/'),
  action: link('guides/github-action/'),
  privacy: link('reference/privacy/'),
  solari: link('reference/solari/'),
  caseStudy: link('examples/echarts-21538/'),
};

const escape = (text: string) =>
  text.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');

/** Light emphasis for recorded output: failures in the accent, passes in green, commands bold. */
function paint(text: string): string {
  return text
    .trimEnd()
    .split('\n')
    .map((line) => {
      let html = escape(line);
      if (/^\$ /.test(line)) return `<span class="t-cmd">${html}</span>`;
      if (/^>>> /.test(line)) return `<span class="t-cmd">${html}</span>`;
      if (/^(<<<|\s+\.\.\. )/.test(line)) return `<span class="t-dim">${html}</span>`;
      html = html
        .replace(/^(REPRODUCED|STILL FAILING)(:.*)$/, '<b class="t-bad">$1</b>$2')
        .replace(/^(FIXED)(:.*)$/, '<b class="t-good">$1</b>$2')
        .replaceAll('✓', '<span class="t-good">✓</span>')
        .replaceAll('✕', '<span class="t-bad">✕</span>')
        .replace(/\b(FAIL)\b/g, '<span class="t-bad">$1</span>')
        .replace(/\b(PASS|pass)\b/g, '<span class="t-good">$1</span>');
      return html;
    })
    .join('\n');
}

/** Sandbox ids run to ~190 characters; the page shows their start. */
const shortenIds = (text: string) => text.replace(/\b([A-Za-z0-9_-]{16})[A-Za-z0-9_.-]{40,}/g, '$1…');

const lines = (text: string) => text.split('\n');

// Step 1: the reporter's capsule, as `inspect` summarizes it (from the recorded agent session).
const summary = lines(mcpLog.slice(0, mcpLog.indexOf('>>> replay')));
const captureExcerpt = [
  '$ twin inspect new-york.json',
  ...summary.filter((line) =>
    /^ {2}(argv|result|time zone)\b|^ {13}(Expected|Received):|^ {2}(node|npm) {2,}|^ {2}commit /.test(line),
  ),
].join('\n');

// The agent session, trimmed to the calls and the lines that matter.
const session = lines(shortenIds(mcpLog.slice(mcpLog.indexOf('>>> replay'))));
const agentExcerpt = session
  .filter(
    (line) =>
      /^(>>>|<<<) /.test(line) ||
      /^(REPRODUCED|FIXED):|^ {2}machine |^TZ=|✕ roundTime_locale|✓ roundTime_locale|^Tests:|^wrote |^released /.test(
        line,
      ),
  )
  .join('\n');

const verifyCommand = '$ twin verify new-york.json --patch fix.patch';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={link('favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('starlight-theme');
        } catch {}
        const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme =
          stored === 'light' || stored === 'dark' ? stored : dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <div class="page">
      <header class="top">
        <a class="mark" href={link('')}>twin</a>
        <nav aria-label="Site">
          <a href={docs.intro}>Docs</a>
          <a href={docs.caseStudy}>Case study</a>
          <a href={REPO}>GitHub</a>
          <button type="button" class="theme" id="theme" aria-label="Switch color theme">dark</button>
        </nav>
      </header>

      <main>
        <section class="intro">
          <h1>Reproduce the bug in the environment where it happens.</h1>
          <p class="lede">
            “Works on my machine” bugs usually aren’t in the code. They’re in a runtime version, a
            dependency the lockfile resolved differently, an environment variable, the time zone. twin
            records the environment a command failed in, rebuilds it on a clean
            <a href={SOLARI}>Solari</a> sandbox, finds the difference that causes the failure, and
            checks a fix there. For maintainers, and for the coding agents working on their issues.
          </p>
          <div class="install">
            <pre><code><span class="t-dim">$</span> {install}</code></pre>
            <button type="button" class="copy" data-copy={install}>copy</button>
          </div>
          <p class="links">
            Node 22 or newer. The reporter needs no account; nothing is uploaded.
            <a href={docs.quickstart}>Quickstart</a> · <a href={docs.intro}>How it works</a>
          </p>
        </section>

        <section id="example">
          <h2>A real bug, start to finish</h2>
          <p>
            <a href={ISSUE}>apache/echarts#21538</a> is an open issue: a date test fails in time zones
            with daylight saving time and passes everywhere else. A maintainer in Kolkata can’t see it.
            Below is the whole path, with output copied from the <a href={EXAMPLE}>recorded runs</a>.
          </p>

          <h3><span class="n">1</span>The reporter captures the failure</h3>
          <p>
            <code>twin capture -- &lt;command&gt;</code> runs the command as usual and records what it ran
            in: OS, runtimes, package manager and lockfile hash, installed versions, commit and diff, time
            zone, environment variable names (values only for a short, safe list), and a fingerprint of the
            failure. Secrets are scrubbed and the reporter reviews the file before it’s written.
          </p>
          <pre><code set:html={paint(captureExcerpt)} /></pre>

          <h3><span class="n">2</span>The maintainer replays it <span class="time">72 s</span></h3>
          <p>
            Same Node, same npm, the exact commit fetched by SHA, <code>npm ci</code> from the lockfile, the
            reporter’s time zone. The command runs a few times and each failure is compared with the one in
            the capsule.
          </p>
          <pre><code set:html={paint(`$ twin replay new-york.json\n${replayLog}`)} /></pre>

          <h3><span class="n">3</span>Bisect names the cause <span class="time">69 s</span></h3>
          <p>
            Given a capsule from a machine where the test passes, twin builds that environment, confirms it
            passes, and applies the differences until it finds the smallest set that makes it fail.
          </p>
          <pre><code set:html={paint(`$ twin bisect new-york.json --good kolkata.json\n${bisectLog}`)} /></pre>

          <h3><span class="n">4</span>Verify checks the fix where it failed <span class="time">71 s</span></h3>
          <p>
            A candidate patch is applied on a fresh copy of the reporter’s environment. Nothing has to be
            pushed first.
          </p>
          <pre><code set:html={paint(`${verifyCommand}\n${verifyLog}`)} /></pre>
          <p class="note">
            This run was recorded before verify got its own report header, so it still says “Replay”.
            <a href={docs.caseStudy}>The full case study</a> has every file.
          </p>
        </section>

        <section id="agents">
          <h2>For coding agents</h2>
          <p>
            An agent asked to fix #21538 runs the tests on its own machine, they pass, and it has nothing to
            go on. If it does write a patch, “the tests pass” is checked in the wrong place. twin gives the
            agent the reporter’s environment through an MCP server:
          </p>
          <pre><code><span class="t-dim">$</span> claude mcp add twin -e SOLARI_API_KEY=slr_live_... -- npx -y github:crypticsaiyan/twin mcp</code></pre>
          <p>
            The tools are <code>inspect</code>, <code>replay</code>, <code>run</code>,
            <code>write_file</code>, <code>verify</code>, <code>bisect</code> and <code>release</code>.
            <code>run</code> executes in the kept machine with the reporter’s env, PATH, time zone and
            working directory. A recorded session on the same issue, driven by a script rather than a model
            (long ids shortened):
          </p>
          <pre><code set:html={paint(agentExcerpt)} /></pre>

          <p>
            The pull request that comes out of it can be checked the same way. The
            <a href={docs.action}>GitHub Action</a> finds the capsule on the issue a pull request closes,
            verifies the head commit in the reporter’s environment, and comments the verdict. The check
            fails unless it’s fixed.
          </p>
          <pre><code>{`on: pull_request
jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: crypticsaiyan/twin@main
        with:
          solari-api-key: \${{ secrets.SOLARI_API_KEY }}`}</code></pre>
          <p><a href={docs.agents}>Agent guide</a> · <a href={docs.action}>Action reference</a></p>
        </section>

        <section id="privacy">
          <h2>What a capsule holds</h2>
          <div class="cols">
            <div>
              <h3>Recorded</h3>
              <ul>
                <li>OS, libc, architecture</li>
                <li>Runtime and package manager versions, lockfile hashes</li>
                <li>Installed Node and Python package versions</li>
                <li>Remote, commit, branch and <code>git diff HEAD</code>, scrubbed</li>
                <li>Time zone and locale</li>
                <li>Values of <code>TZ</code>, <code>NODE_ENV</code>, <code>LANG</code>, <code>CI</code> and a few others</li>
                <li>Exit status, output tail and a failure fingerprint, scrubbed</li>
              </ul>
            </div>
            <div>
              <h3>Never recorded</h3>
              <ul>
                <li>Other environment variable values: names only</li>
                <li>Tokens, keys and passwords: pattern and entropy rules replace them</li>
                <li>Home directory paths: rewritten to <code>~</code></li>
                <li>Contents of untracked files: names only</li>
              </ul>
              <p class="note">The reporter sees a summary, and the full JSON if they want, before anything is written. <a href={docs.privacy}>Details</a></p>
            </div>
          </div>
        </section>

        <section id="compare">
          <h2>Where it fits</h2>
          <table>
            <thead>
              <tr><th>Tool</th><th>What it does</th><th>What twin adds</th></tr>
            </thead>
            <tbody>
              <tr><td><code>envinfo</code></td><td>prints versions as text</td><td>a capsule that can be replayed, diffed and bisected</td></tr>
              <tr><td>Dev containers, Codespaces, Nix</td><td>give contributors the maintainer’s environment</td><td>the reporter’s environment</td></tr>
              <tr><td>StackBlitz, CodeSandbox</td><td>browser repros of a minimal example</td><td>the reporter’s real commit, lockfile, env and time zone, on a Linux VM</td></tr>
              <tr><td><code>git bisect</code></td><td>finds the commit that broke it</td><td>finds the environment difference at a fixed commit</td></tr>
              <tr><td>wsp</td><td>clones your own setup into cloud workspaces for your agents</td><td>rebuilds a stranger’s failing environment from a scrubbed file and verifies fixes in it</td></tr>
            </tbody>
          </table>
          <p class="note">
            Replay runs on Linux only; a macOS or Windows capsule is replayed with the same versions on
            Linux. Bisect varies env values, time zone, Node version, npm dependency versions and the
            working-tree diff.
          </p>
        </section>

        <section id="solari">
          <h2>Built on Solari</h2>
          <p>
            Each replay, bisect or verify gets its own sandbox, streamed with a real timeout and released
            with a confirmed kill. A kept machine can be opened with <code>twin shell</code>, or shared as a
            password-protected browser terminal. At about $0.125 per sandbox-hour, the runs above cost a
            fraction of a cent each. Building twin also turned up some
            <a href={docs.solari}>platform behavior worth knowing</a>.
          </p>
        </section>
      </main>

      <footer>
        <span>twin · MIT</span>
        <a href={REPO}>GitHub</a>
        <a href={docs.intro}>Docs</a>
      </footer>
    </div>

    <script>
      const root = document.documentElement;
      const toggle = document.getElementById('theme') as HTMLButtonElement;
      const label = () => {
        toggle.textContent = root.dataset.theme === 'dark' ? 'light' : 'dark';
      };
      label();
      toggle.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        try {
          localStorage.setItem('starlight-theme', root.dataset.theme);
        } catch {}
        label();
      });
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? '');
            button.textContent = 'copied';
            setTimeout(() => (button.textContent = 'copy'), 1500);
          } catch {}
        });
      }
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--twin-bg);
    color: var(--twin-text);
    font: 400 1.0625rem/1.65 var(--twin-font-body);
  }

  .page {
    max-width: calc(var(--twin-wide) + 2.5rem);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  a {
    color: var(--twin-link);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: var(--twin-text-muted);
  }

  a:hover {
    text-decoration-color: var(--twin-accent);
  }

  :focus-visible {
    outline: 2px solid var(--twin-accent);
    outline-offset: 2px;
  }

  .top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--twin-rule);
  }

  .mark {
    font: 600 1.1rem var(--twin-font-mono);
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
    font-size: 0.95rem;
  }

  nav a {
    text-decoration: none;
    color: var(--twin-text-muted);
  }

  nav a:hover {
    color: var(--twin-text);
  }

  button {
    font: inherit;
    color: var(--twin-text-muted);
    background: none;
    border: 1px solid var(--twin-rule);
    border-radius: var(--twin-radius);
    padding: 0.1rem 0.5rem;
    cursor: pointer;
  }

  button:hover {
    color: var(--twin-text);
  }

  main > section {
    padding: 3.5rem 0 0.5rem;
  }

  main :is(p, h1, h2, h3, ul) {
    max-width: var(--twin-measure);
  }

  main > section + section {
    border-top: 1px solid var(--twin-rule);
    margin-top: 3rem;
  }

  h1,
  h2,
  h3 {
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    letter-spacing: -0.02em;
    margin: 1.5rem 0 1.25rem;
    max-width: 18ch;
  }

  h2 {
    font-size: 1.5rem;
    margin: 0 0 1rem;
  }

  h3 {
    font-size: 1.1rem;
    margin: 2.5rem 0 0.5rem;
  }

  h3 .n {
    font: 500 0.95rem var(--twin-font-mono);
    color: var(--twin-accent);
    margin-right: 0.6rem;
  }

  h3 .time {
    font: 400 0.85rem var(--twin-font-mono);
    color: var(--twin-text-muted);
    margin-left: 0.4rem;
  }

  p {
    margin: 0 0 1rem;
  }

  .lede {
    font-size: 1.15rem;
    color: var(--twin-text);
  }

  .note,
  .links {
    color: var(--twin-text-muted);
    font-size: 0.95rem;
  }

  code {
    font-family: var(--twin-font-mono);
    font-size: 0.88em;
  }

  :not(pre) > code {
    background: var(--twin-bg-code);
    padding: 0.1em 0.3em;
    border-radius: 3px;
  }

  pre {
    margin: 0 0 1.25rem;
    padding: 1rem 1.1rem;
    background: var(--twin-bg-code);
    border: 1px solid var(--twin-rule);
    border-radius: var(--twin-radius);
    overflow-x: auto;
    font-size: 0.82rem;
    line-height: 1.55;
    scrollbar-width: thin;
  }

  pre code {
    font-size: inherit;
  }

  .t-cmd {
    font-weight: 500;
  }

  .t-dim {
    color: var(--twin-text-muted);
  }

  .t-bad {
    color: var(--twin-accent);
  }

  .t-good {
    color: var(--twin-pass);
  }

  .install {
    position: relative;
  }

  .install pre {
    padding-right: 4.5rem;
    font-size: 0.9rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .copy {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    font-size: 0.8rem;
    background: var(--twin-bg);
  }

  ul {
    padding-left: 1.1rem;
    margin: 0 0 1rem;
  }

  li {
    margin-bottom: 0.3rem;
  }

  .cols {
    display: grid;
    gap: 0 2.5rem;
    grid-template-columns: 1fr;
  }

  .cols h3 {
    margin-top: 0.5rem;
  }

  @media (min-width: 44rem) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }

  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.93rem;
    margin-bottom: 1rem;
  }

  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 0.55rem 0.75rem 0.55rem 0;
    border-bottom: 1px solid var(--twin-rule);
  }

  th {
    font-weight: 600;
  }

  @media (max-width: 36rem) {
    table,
    tbody,
    tr,
    td {
      display: block;
    }

    thead {
      display: none;
    }

    tr {
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--twin-rule);
    }

    td {
      border: 0;
      padding: 0.1rem 0;
    }

    td:first-child {
      font-weight: 600;
    }
  }

  footer {
    display: flex;
    gap: 1.25rem;
    margin-top: 4rem;
    padding: 1.5rem 0 2.5rem;
    border-top: 1px solid var(--twin-rule);
    color: var(--twin-text-muted);
    font-size: 0.9rem;
  }

  footer span {
    margin-right: auto;
  }
</style>
