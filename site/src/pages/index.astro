                            </span>
                            <span class="patch-state" aria-live="polite">applied</span>
                          </p>
                          <pre><code>{patchExcerpt.map(({ sign, text }) => <span class={`ln ${sign === '+' ? 'add' : 'del'}`}><span class="sign">{sign}</span>{text}</span>)}</code></pre>
                        </div>
                        <pre><code>{step.lines?.map((line) => <span class={lineClass(line)} data-type={line.type} data-pending={line.pending} data-seconds={line.seconds} data-ref={line.ref} set:html={line.html} />)}</code></pre>
                      </figure>
                    )}
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      <section class="band" aria-labelledby="agents">
        <div class="col sec">
          <div class="rail"><p><span>04</span> Agents</p></div>
