---
import '@fontsource/doto/700.css';
import '@fontsource/doto/900.css';
import '@fontsource/silkscreen/400.css';
import '@fontsource/vt323/400.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/400-italic.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/tokens.css';
import bisectLog from '../../../examples/echarts-21538/bisect.txt?raw';
import mcpLog from '../../../examples/echarts-21538/mcp.txt?raw';
import replayLog from '../../../examples/echarts-21538/replay.txt?raw';
import verifyLog from '../../../examples/echarts-21538/verify.txt?raw';
import { EXAMPLE, ISSUE, link, REPO, SOLARI } from '../site';

const title = 'twin(1)';
const description =
  'twin records the environment a command failed in, rebuilds it on a clean Solari sandbox, finds the difference that causes the failure, and checks a fix there.';
const canonical = new URL(link(''), Astro.site).href;
const install = 'npx github:crypticsaiyan/twin capture -- npm test';

const docs = {
  intro: link('start/introduction/'),
  quickstart: link('start/quickstart/'),
  cli: link('reference/cli/'),
  agents: link('guides/ai-agents/'),
  action: link('guides/github-action/'),
  privacy: link('reference/privacy/'),
  limits: link('reference/limits/'),
  solari: link('reference/solari/'),
  caseStudy: link('examples/echarts-21538/'),
};

const escape = (text: string) =>
  text.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');

/** Ribbon colors for recorded output: failures in red, passes in green, commands bold. */
function paint(text: string): string {
  return text
    .trimEnd()
    .split('\n')
    .map((line) => {
      let html = escape(line);
      if (/^(\$|&gt;&gt;&gt;) /.test(html)) return `<span class="t-cmd">${html}</span>`;
      if (/^(&lt;&lt;&lt;|\s+\.\.\. )/.test(html)) return `<span class="t-dim">${html}</span>`;
      html = html
        .replace(/^(REPRODUCED|STILL FAILING)(:.*)$/, '<span class="t-bad t-verdict">$1</span>$2')
        .replace(/^(FIXED)(:.*)$/, '<span class="t-good t-verdict">$1</span>$2')
        .replaceAll('✓', '<span class="t-good">✓</span>')
        .replaceAll('✕', '<span class="t-bad">✕</span>')
        .replace(/\b(FAIL)\b/g, '<span class="t-bad">$1</span>')
        .replace(/\b(PASS|pass)\b/g, '<span class="t-good">$1</span>');
      return html;
    })
    .join('\n');
}

/** Sandbox ids run to ~190 characters; the page shows their start. */
const shortenIds = (text: string) =>
  text.replace(/\b([A-Za-z0-9_-]{16})[A-Za-z0-9_.-]{40,}/g, '$1…');
const lines = (text: string) => text.split('\n');

// The reporter's capsule, as `inspect` summarizes it (from the recorded agent session).
const summary = lines(mcpLog.slice(0, mcpLog.indexOf('>>> replay')));
const captureLog = [
  '$ twin inspect new-york.json',
  ...summary.filter((line) =>
    /^ {2}(argv|result|time zone)\b|^ {13}(Expected|Received):|^ {2}(node|npm) {2,}|^ {2}commit /.test(
      line,
    ),
  ),
].join('\n');

// The agent session, trimmed to the calls and the lines that matter.
const agentLog = lines(shortenIds(mcpLog.slice(mcpLog.indexOf('>>> replay'))))
  .filter(
    (line) =>
      /^(>>>|<<<) /.test(line) ||
      /^(REPRODUCED|FIXED):|^ {2}machine |^TZ=|✕ roundTime_locale|✓ roundTime_locale|^Tests:|^wrote |^released /.test(
        line,
      ),
  )
  .join('\n');

const synopsis = [
  ['twin capture -- <command>', 'run the command and record the environment it failed in'],
  ['twin inspect <capsule> [<other>]', 'summarize a capsule, or list every difference between two'],
  ['twin replay <capsule> [--keep]', 'rebuild it on a clean Solari sandbox and rerun'],
  ['twin bisect <bad> --good <good>', 'find the smallest difference that makes it fail'],
  ['twin verify <capsule> --patch <file>', "check a fix in the reporter's environment"],
  ['twin shell [machine] [--web]', 'open a terminal on a kept machine, or share one'],
  ['twin mcp', 'give a coding agent all of the above over MCP'],
];

const steps = [
  {
    cmd: 'capture',
    title: 'The reporter captures the failure',
    time: null,
    text: 'Runs the command as usual and records what it ran in: OS, runtimes, package manager and lockfile hash, installed versions, commit and diff, time zone, environment variable names, and a fingerprint of the failure. Secrets are scrubbed; the reporter reviews the file before it is written.',
    log: captureLog,
  },
  {
    cmd: 'replay',
    title: 'The maintainer replays it',
    time: '72 s',
    text: 'Same Node, same npm, the exact commit fetched by SHA, npm ci from the lockfile, the reporter’s time zone. Each attempt is compared with the failure in the capsule.',
    log: `$ twin replay new-york.json\n${replayLog}`,
  },
  {
    cmd: 'bisect',
    title: 'Bisect names the cause',
    time: '69 s',
    text: 'Given a capsule from a machine where the test passes, twin builds that environment, checks that it passes, and applies the differences until the smallest set that fails is left.',
    log: `$ twin bisect new-york.json --good kolkata.json\n${bisectLog}`,
  },
  {
    cmd: 'verify',
    title: 'Verify checks the fix where it failed',
    time: '71 s',
    text: 'The patch goes onto a fresh copy of the reporter’s environment. Nothing is pushed first. (This run predates the verify report header, so it still prints “Replay”.)',
    log: `$ twin verify new-york.json --patch fix.patch\n${verifyLog}`,
  },
];

const seeAlso = [
  ['envinfo(1)', 'prints versions as text. twin’s capsule can be replayed, diffed and bisected.'],
  ['devcontainer(1), nix(1)', 'give contributors the maintainer’s environment. twin rebuilds the reporter’s.'],
  ['git-bisect(1)', 'finds the commit that broke it. twin finds the environment difference at a fixed commit.'],
  ['StackBlitz, CodeSandbox', 'run minimal repros in a browser. twin uses the reporter’s real commit, lockfile, env and time zone.'],
  ['wsp', 'clones your own setup into cloud workspaces for your agents. twin rebuilds a stranger’s failing environment from a scrubbed file.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={link('favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content="twin" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('starlight-theme');
        } catch {}
        if (stored === 'light' || stored === 'dark') document.documentElement.dataset.theme = stored;
      })();
    </script>
  </head>
  <body>
    <div class="sheet">
      <header class="running">
        <span>TWIN(1)</span>
        <span class="center">General Commands Manual</span>
        <span>TWIN(1)</span>
      </header>

      <nav class="nav" aria-label="Site">
        <a href={docs.intro}>docs</a>
        <a href={docs.caseStudy}>case study</a>
        <a href={REPO}>github</a>
        <button type="button" id="theme" class="theme">[ terminal ]</button>
      </nav>

      <main>
        <section class="hero" aria-labelledby="name">
          <div class="hero-name">
            <h1 id="name" class="wordmark">twin<span class="cursor" aria-hidden="true"></span></h1>
            <p class="whatis">reproduce a bug in the environment where it was reported</p>
          </div>
          <div class="hero-text">
          <p class="lede">
            Most “works on my machine” bugs aren’t in the code. They’re in a runtime version, a
            dependency the lockfile resolved differently, an environment variable, the time zone. twin
            records the environment a command failed in, rebuilds it on a clean
            <a href={SOLARI}>Solari</a> sandbox, finds the difference that causes the failure, and
            checks a fix there. For maintainers, and for the coding agents working on their issues.
          </p>
          <div class="install">
            <pre><code><span class="t-dim">$</span> {install}</code></pre>
            <button type="button" class="copy" data-copy={install}>copy</button>
          </div>
          <p class="small">
            Node 22 or newer. The reporter needs no account and nothing is uploaded. ·
            <a href={docs.quickstart}>quickstart</a>
          </p>
          </div>
        </section>

        <section aria-labelledby="synopsis">
          <h2 id="synopsis">Synopsis</h2>
          <dl class="synopsis">
            {
              synopsis.map(([cmd, what]) => (
                <div>
                  <dt>
                    <code>{cmd}</code>
                  </dt>
                  <dd>{what}</dd>
                </div>
              ))
            }
          </dl>
          <p class="small">Every command has <code>--help</code>. <a href={docs.cli}>Full reference</a></p>
        </section>

        <section aria-labelledby="example">
          <h2 id="example">Example</h2>
          <p>
            <a href={ISSUE}>apache/echarts#21538</a> is an open issue: a date test fails in time zones
            with daylight saving time and passes everywhere else, so a maintainer in Kolkata can’t see it.
            This is the whole path, printed from the <a href={EXAMPLE}>recorded runs</a>.
          </p>
          <ol class="steps">
            {
              steps.map((step) => (
                <li class="pair">
                  <div>
                  <h3>
                    <span class="cmd">twin {step.cmd}</span>
                    <span class="title">{step.title}</span>
                    {step.time && <span class="time">{step.time}</span>}
                  </h3>
                  <p>{step.text}</p>
                  </div>
                  <pre class="printout"><code set:html={paint(step.log)} /></pre>
                </li>
              ))
            }
          </ol>
        </section>

        <section aria-labelledby="agents">
          <h2 id="agents">Agents</h2>
          <div class="pair">
            <div><p>
            A coding agent asked to fix #21538 runs the tests on its own machine, they pass, and it has
            nothing to work with. Its “tests pass” is also checked in the wrong place. The MCP server
            gives the agent the reporter’s machine:
          </p></div>
            <pre class="plain"><code><span class="t-dim">$</span> claude mcp add twin -e SOLARI_API_KEY=slr_live_... -- npx -y github:crypticsaiyan/twin mcp</code></pre>
          </div>
          <div class="pair">
            <div><p>
            Tools: <code>inspect</code>, <code>replay</code>, <code>run</code>, <code>write_file</code>,
            <code>verify</code>, <code>bisect</code>, <code>release</code>. <code>run</code> executes in
            the kept machine with the reporter’s env, PATH, time zone and working directory. A recorded
            session on the same issue, driven by a script rather than a model (ids shortened):
          </p></div>
            <pre class="printout"><code set:html={paint(agentLog)} /></pre>
          </div>
          <div class="pair">
            <div><p>
            The pull request that comes out of it is checked the same way. The
            <a href={docs.action}>GitHub Action</a> finds the capsule on the issue a pull request
            closes, verifies the head commit in the reporter’s environment and comments the verdict. The
            check fails unless it is fixed.
          </p></div>
            <pre class="plain"><code>{`on: pull_request
jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: crypticsaiyan/twin@main
        with:
          solari-api-key: \${{ secrets.SOLARI_API_KEY }}`}</code></pre>
          </div>
          <p class="small"><a href={docs.agents}>agent guide</a> · <a href={docs.action}>action reference</a></p>
        </section>

        <section aria-labelledby="files">
          <h2 id="files">Files</h2>
          <p><code>twin-capsule.json</code>, a few kilobytes, attached to the issue by the reporter.</p>
          <div class="cols">
            <div>
              <h3 class="label">recorded</h3>
              <ul>
                <li>OS, libc, architecture</li>
                <li>runtime and package manager versions, lockfile hashes</li>
                <li>installed Node and Python package versions</li>
                <li>remote, commit, branch, <code>git diff HEAD</code></li>
                <li>time zone and locale</li>
                <li>values of <code>TZ</code>, <code>NODE_ENV</code>, <code>LANG</code>, <code>CI</code> and a few more</li>
                <li>exit status, output tail, failure fingerprint</li>
              </ul>
            </div>
            <div>
              <h3 class="label">never recorded</h3>
              <ul>
                <li>other environment values: names only</li>
                <li>tokens, keys, passwords: replaced by pattern and entropy rules</li>
                <li>home directory paths: rewritten to <code>~</code></li>
                <li>untracked file contents: names only</li>
              </ul>
              <p class="small">The reporter sees a summary, and the full JSON if they want, before anything is written. <a href={docs.privacy}>details</a></p>
            </div>
          </div>
        </section>

        <section aria-labelledby="see-also">
          <h2 id="see-also">See also</h2>
          <dl class="seealso">
            {
              seeAlso.map(([name, what]) => (
                <div>
                  <dt>{name}</dt>
                  <dd>{what}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section aria-labelledby="bugs">
          <h2 id="bugs">Bugs</h2>
          <p>
            Replay runs on Linux only; a macOS or Windows capsule is replayed with the same versions on
            Linux, and if it passes there, that points at the OS. Bisect varies env values, time zone,
            Node version, npm dependency versions and the working-tree diff.
            <a href={docs.limits}>All limits</a>.
          </p>
          <p>
            Each run gets its own Solari sandbox, streamed with a real timeout and released with a
            confirmed kill; at about $0.125 per sandbox-hour the runs above cost a fraction of a cent.
            Building twin turned up <a href={docs.solari}>platform bugs worth knowing</a>, such as
            killed sandboxes that kept billing, and came back hours later.
          </p>
        </section>
      </main>

      <footer class="running">
        <span>twin 0.1.0</span>
        <span class="center">2026-09-28</span>
        <span>TWIN(1)</span>
      </footer>
    </div>

    <script>
      const root = document.documentElement;
      const toggle = document.getElementById('theme') as HTMLButtonElement;
      const isDark = () =>
        root.dataset.theme === 'dark' ||
        (!root.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
      const label = () => {
        toggle.textContent = isDark() ? '[ printout ]' : '[ terminal ]';
        toggle.setAttribute('aria-label', isDark() ? 'Switch to light theme' : 'Switch to dark theme');
      };
      label();
      toggle.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {}
        label();
      });
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', label);
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? '');
            button.textContent = 'copied';
          } catch {
            const code = button.previousElementSibling;
            if (code) window.getSelection()?.selectAllChildren(code);
            button.textContent = 'selected';
          }
          setTimeout(() => (button.textContent = 'copy'), 1500);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    background: var(--twin-paper);
  }

  body {
    margin: 0;
    background: var(--twin-paper);
    color: var(--twin-ink);
    font: 400 0.95rem/1.7 var(--twin-font-body);
  }

  /* The CRT's scanlines; transparent on paper. */
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 2px,
      var(--twin-scanlines) 2px 3px
    );
    z-index: 10;
  }

  a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  a:hover {
    color: var(--twin-fail);
  }

  :focus-visible {
    outline: 2px dashed var(--twin-fail);
    outline-offset: 3px;
  }

  .sheet {
    max-width: 86rem;
    margin: 0 auto;
    padding-inline: clamp(1rem, 4vw, 3.5rem);
    padding-block: 1.25rem 0;
  }

  .running {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font: 400 0.7rem/1.6 var(--twin-font-label);
    letter-spacing: 0.06em;
    color: var(--twin-ink-dim);
  }

  .running .center {
    text-align: center;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: baseline;
    gap: 0.4rem 1.25rem;
    margin-top: 0.75rem;
    font-size: 0.85rem;
  }

  .nav a {
    text-decoration: none;
  }

  .nav a:hover {
    text-decoration: underline;
  }

  button {
    font: 400 0.7rem var(--twin-font-label);
    letter-spacing: 0.04em;
    color: var(--twin-ink);
    background: transparent;
    border: 0;
    padding: 0.2rem 0;
    cursor: pointer;
  }

  button:hover {
    color: var(--twin-fail);
  }

  main {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    padding-block: 1.5rem 4rem;
  }

  /* Man-page layout: headings flush left, bodies indented. */
  main > section:not(.hero) > :not(h2) {
    margin-left: 3ch;
  }

  main p,
  main ul {
    max-width: 64ch;
  }

  p {
    margin: 0 0 1rem;
  }

  h2 {
    margin: 0 0 1rem;
    font: 900 1.9rem/1 var(--twin-font-display);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--twin-display);
    text-shadow: 0 0 12px var(--twin-glow);
  }

  .hero {
    padding-top: 1rem;
  }

  .wordmark {
    margin: 0;
    font: 900 clamp(5.5rem, 18vw, 13rem)/0.85 var(--twin-font-display);
    white-space: nowrap;
    letter-spacing: -0.02em;
    color: var(--twin-display);
    text-shadow: 0 0 22px var(--twin-glow);
  }

  /* A block cursor after the name, as at a prompt waiting for input. */
  .cursor {
    display: inline-block;
    width: 0.32em;
    height: 0.48em;
    margin-left: 0.1em;
    vertical-align: baseline;
    background: var(--twin-fail);
    animation: blink 1.1s steps(1, end) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  .whatis {
    margin: 1.25rem 0 1.5rem;
    font: 400 0.95rem var(--twin-font-label);
    letter-spacing: 0.02em;
    text-wrap: balance;
  }

  .whatis::before {
    content: 'twin - ';
    color: var(--twin-ink-dim);
  }

  .lede {
    font-size: 1rem;
  }

  .small {
    font-size: 0.82rem;
    color: var(--twin-ink-dim);
  }

  code {
    font-family: var(--twin-font-mono);
    font-size: 0.92em;
  }

  pre {
    margin: 0 0 1.25rem;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  pre code {
    font-size: inherit;
  }

  pre.plain,
  .install pre {
    padding: 0.8rem 1rem;
    border: 1px solid var(--twin-rule);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  /* Printer output: VT323 on greenbar, three lines per band. */
  pre.printout {
    --line: 1.35rem;
    padding: 0 1.25ch;
    font-family: var(--twin-font-term);
    font-size: 1.2rem;
    line-height: var(--line);
    background: repeating-linear-gradient(
      to bottom,
      var(--twin-greenbar) 0 calc(var(--line) * 3),
      transparent calc(var(--line) * 3) calc(var(--line) * 6)
    );
    border-block: 1px solid var(--twin-rule);
  }

  pre.printout code {
    font-family: inherit;
  }

  .install {
    position: relative;
    max-width: 44rem;
  }

  .install pre {
    padding-right: 5rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .copy {
    position: absolute;
    top: 0.75rem;
    right: 0.9rem;
  }

  .t-cmd {
    font-weight: 600;
  }

  pre.printout .t-cmd {
    font-weight: 400;
    color: var(--twin-display);
  }

  .t-dim {
    color: var(--twin-ink-dim);
  }

  .t-bad {
    color: var(--twin-fail);
  }

  .t-good {
    color: var(--twin-pass);
  }

  .t-verdict {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .synopsis,
  .seealso {
    display: grid;
    gap: 0.35rem;
    margin: 0 0 1rem;
  }

  .synopsis div,
  .seealso div {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: 0 2ch;
  }

  .seealso div {
    grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
  }

  dt {
    font-weight: 600;
  }

  dd {
    margin: 0;
    color: var(--twin-ink-dim);
  }

  .seealso dd {
    color: var(--twin-ink);
  }

  /* Explanation beside its output on wide screens, stacked otherwise. */
  .pair {
    display: grid;
    gap: 0 3rem;
    align-items: start;
  }

  .pair + .pair {
    margin-top: 1.5rem;
  }

  @media (min-width: 64rem) {
    .pair {
      grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
    }
  }

  @media (min-width: 80rem) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 34rem);
      gap: 1rem 4rem;
      align-items: center;
    }

    .whatis {
      margin-bottom: 0;
    }

    .wordmark {
      font-size: clamp(5.5rem, 12.5vw, 13rem);
    }
  }

  .steps {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .steps h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .steps .cmd {
    font: 400 0.75rem var(--twin-font-label);
    letter-spacing: 0.04em;
    color: var(--twin-fail);
  }

  .steps .time {
    font: 400 1.1rem var(--twin-font-term);
    color: var(--twin-ink-dim);
  }

  .label {
    margin: 0 0 0.5rem;
    font: 400 0.75rem var(--twin-font-label);
    letter-spacing: 0.06em;
