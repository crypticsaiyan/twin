---
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/doto/900.css';
import '../styles/tokens.css';
import { link, REPO, SOLARI } from '../site';

const title = 'twin';
const description =
  'twin records the environment a command failed in, rebuilds it on a clean Solari sandbox, finds the difference that causes the failure, and checks a fix there.';
const canonical = new URL(link(''), Astro.site).href;
const install = 'npm install -g @crypticsaiyan/twincli';

const docs = {
  intro: link('start/introduction/'),
  quickstart: link('start/quickstart/'),
  cli: link('reference/cli/'),
  agents: link('guides/ai-agents/'),
  action: link('guides/github-action/'),
  privacy: link('reference/privacy/'),
  solari: link('reference/solari/'),
  caseStudy: link('examples/echarts-21538/'),
};

const steps = [
  ['capture', 'twin capture -- <command>', 'Run the command and record the environment it failed in.'],
  ['replay', 'twin replay <capsule>', 'Rebuild it on a clean Solari sandbox and rerun the command.'],
  ['bisect', 'twin bisect <bad> --good <good>', 'Find the smallest difference that makes it fail.'],
  ['verify', 'twin verify <capsule> --patch <file>', 'Check a fix in the reporter’s environment.'],
];

const mcp = 'claude mcp add twin -e SOLARI_API_KEY=slr_live_... -- npx -y @crypticsaiyan/twincli mcp';
const action = `on: pull_request
jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: crypticsaiyan/twin@main
        with:
          solari-api-key: \${{ secrets.SOLARI_API_KEY }}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={link('favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content="twin" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let stored = null;
        try {
          stored = localStorage.getItem('starlight-theme');
        } catch {}
        if (stored === 'light' || stored === 'dark') root.dataset.theme = stored;
      })();
    </script>
  </head>
  <body>
    <header class="band band-nav">
      <div class="col nav">
        <a class="logo" href={link('')} aria-label="twin home">twin<span class="cursor" aria-hidden="true"></span></a>
        <nav aria-label="Site">
          <a href={docs.intro}>Docs</a>
          <a href={docs.caseStudy}>Case studies</a>
          <a href={REPO}>GitHub</a>
          <button type="button" id="theme">Dark</button>
        </nav>
      </div>
    </header>

    <main>
      <section class="band">
        <div class="col hero">
          <div class="hero-text">
            <p class="kicker">For open source maintainers and coding agents</p>
            <h1>Reproduce the bug in the environment where it was reported.</h1>
            <p class="lede">
              twin records the environment a command failed in, rebuilds it on a clean
              <a href={SOLARI}>Solari</a> sandbox, finds the difference that causes the failure, and
              checks a fix there.
            </p>
            <div class="install">
              <pre><code><span class="t-dim">$</span> {install}</code></pre>
              <button type="button" class="copy" data-copy={install}>Copy</button>
            </div>
            <p class="actions">
              <a class="button" href={docs.quickstart}>Get started</a>
              <a href={docs.caseStudy}>Read the case studies</a>
            </p>
          </div>
          <div class="hero-demo split">
            <figure class="film">
              <video preload="metadata" playsinline poster={link('demo/twin-demo-poster.jpg')}>
                <source src={link('demo/twin-demo.mp4')} type="video/mp4" />
              </video>
              <button type="button" class="film-big" aria-label="Play the demo film">Play film</button>
              <div class="film-bar">
                <button type="button" class="film-toggle" aria-label="Play">Play</button>
                <input class="film-seek" type="range" min="0" max="1000" value="0" aria-label="Seek" />
                <span class="film-time">0:00 / 3:35</span>
                <button type="button" class="film-mute" aria-label="Mute">Sound on</button>
                <button type="button" class="film-full" aria-label="Full screen">Full</button>
              </div>
            </figure>
          </div>
        </div>
      </section>

      <section class="band" aria-labelledby="flow">
        <div class="col sec">
          <div class="rail"><p>How it works</p></div>
          <div class="body split">
            <h2 id="flow">Four commands, one file between them</h2>
            <ol class="flow">
              {
                steps.map(([name, cmd, what]) => (
                  <li>
                    <code>{cmd}</code>
                    <p>{what}</p>
                  </li>
                ))
              }
            </ol>
            <p class="small"><a href={docs.cli}>Full reference</a></p>
          </div>
        </div>
      </section>

      <section class="band" aria-labelledby="agents">
        <div class="col sec">
          <div class="rail"><p>For agents</p></div>
          <div class="body split">
            <h2 id="agents">Give coding agents the reporter’s machine</h2>
            <div class="agents">
              <div>
                <p>
                  twin’s MCP server lets an agent replay the failure, run commands in the reporter’s
                  environment, and verify its diff on a fresh machine.
                </p>
                <p class="small"><a href={docs.agents}>Agent guide</a></p>
                <figure class="term">
                  <figcaption><span>Add to Claude Code</span></figcaption>
                  <pre><code><span class="t-dim">$</span> {mcp}</code></pre>
                </figure>
              </div>
              <div>
                <p>
                  The GitHub Action verifies each pull request in the reporter’s environment and fails
                  unless the bug is fixed.
                </p>
                <p class="small"><a href={docs.action}>Action reference</a></p>
                <figure class="term">
                  <figcaption><code>.github/workflows/twin.yml</code></figcaption>
                  <pre><code>{action}</code></pre>
                </figure>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="band band-foot">
      <div class="col foot">
        <span class="logo small-logo">twin</span>
        <span>MIT license</span>
        <a href={REPO}>GitHub</a>
        <a href={docs.intro}>Docs</a>
        <a href={docs.cli}>Reference</a>
        <a href={docs.privacy}>Privacy</a>
      </div>
    </footer>

    <script>
      const film = document.querySelector<HTMLElement>('.film');
      const video = film?.querySelector('video');
      if (film && video) {
        const $ = <T extends HTMLElement>(selector: string) => film.querySelector(selector) as T;
        const toggleButton = $<HTMLButtonElement>('.film-toggle');
        const seek = $<HTMLInputElement>('.film-seek');
        const time = $<HTMLElement>('.film-time');
        const mute = $<HTMLButtonElement>('.film-mute');
        const clock = (seconds: number) =>
          `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, '0')}`;
        const paint = () => {
          const total = video.duration || 0;
          seek.value = total ? String((video.currentTime / total) * 1000) : '0';
          seek.style.setProperty('--done', `${Number(seek.value) / 10}%`);
          time.textContent = `${clock(video.currentTime)} / ${clock(total)}`;
        };
        const flip = () => (video.paused ? video.play() : video.pause());
        video.addEventListener('play', () => {
          film.dataset.state = 'playing';
          toggleButton.textContent = 'Pause';
        });
        video.addEventListener('pause', () => {
          film.dataset.state = 'paused';
          toggleButton.textContent = 'Play';
        });
        video.addEventListener('timeupdate', paint);
        video.addEventListener('loadedmetadata', paint);
        video.addEventListener('click', flip);
        toggleButton.addEventListener('click', flip);
        $<HTMLButtonElement>('.film-big').addEventListener('click', flip);
        seek.addEventListener('input', () => {
          video.currentTime = (Number(seek.value) / 1000) * (video.duration || 0);
        });
        mute.addEventListener('click', () => {
          video.muted = !video.muted;
          mute.textContent = video.muted ? 'Sound off' : 'Sound on';
        });
        $<HTMLButtonElement>('.film-full').addEventListener('click', () => {
          if (document.fullscreenElement) void document.exitFullscreen();
          else void film.requestFullscreen?.();
        });
      }

      const root = document.documentElement;
      const toggle = document.getElementById('theme') as HTMLButtonElement;
      const isDark = () =>
        root.dataset.theme === 'dark' ||
        (!root.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
      const label = () => {
        toggle.textContent = isDark() ? 'Light' : 'Dark';
        toggle.setAttribute('aria-label', isDark() ? 'Switch to light theme' : 'Switch to dark theme');
      };
      label();
      toggle.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {}
        label();
      });
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', label);
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? '');
            button.textContent = 'Copied';
          } catch {
            const code = button.previousElementSibling;
            if (code) window.getSelection()?.selectAllChildren(code);
            button.textContent = 'Selected';
          }
          setTimeout(() => (button.textContent = 'Copy'), 1500);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  [hidden] {
    display: none !important;
  }

  :root {
    /* The page column: its hairline frame sits --inset from the viewport edge. */
    --col-max: 120rem;
    --inset: clamp(0.5rem, 1.5vw, 2rem);
    --pad: 1rem;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (min-width: 48rem) {
    :root {
      --pad: 2rem;
    }
  }

  @media (min-width: 80rem) {
    :root {
      --pad: 4rem;
    }
  }

  @media (min-width: 100rem) {
    :root {
      --pad: 6rem;
    }
  }

  html {
    -webkit-text-size-adjust: 100%;
    background: var(--twin-bg);
    scrollbar-color: var(--twin-rule) transparent;
    overflow-x: clip;
  }

  pre {
    scrollbar-color: var(--twin-rule) transparent;
  }

  body {
    margin: 0;
    background: var(--twin-bg);
    color: var(--twin-text);
    font: 400 0.9375rem/1.85 var(--twin-font-body);
    /* Commands are shown literally: no programming ligatures for -- or =>. */
    font-variant-ligatures: none;
    font-feature-settings: 'calt' 0;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  :focus-visible {
    outline: 2px solid var(--twin-focus);
    outline-offset: 2px;
  }

  button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  /* Small bordered controls: theme toggle, copy, play again. */
  #theme,
  .copy,
  .again {
    font: 500 0.75rem/1.4 var(--twin-font-body);
    color: var(--twin-text-muted);
    border: 1px solid var(--twin-rule);
    background: var(--twin-bg);
    padding: 0.25rem 0.65rem;
  }

  /* "Dark" and "Light" differ in width; a fixed width keeps the header from shifting. */
  #theme {
    min-width: 4.25rem;
    text-align: center;
  }

  #theme:hover,
  .copy:hover,
  .again:hover {
    color: var(--twin-text);
    border-color: var(--twin-text-muted);
  }

  /* The frame: a bordered column, closed by rules that end at its edges, like stacked boxes. */
  .band-foot {
    margin-bottom: 4rem;
  }

  .col {
    position: relative;
    width: min(var(--col-max), 100% - 2 * var(--inset));
    margin-inline: auto;
    padding-inline: var(--pad);
    border-inline: 1px solid var(--twin-rule);
  }

  .band:not(.band-nav) > .col {
    border-top: 1px solid var(--twin-rule);
  }

  .band-foot > .col {
    border-bottom: 1px solid var(--twin-rule);
  }

  .split {
    position: relative;
  }

  /* A sub-row inside a section, ruled across the full cell. */
  .steps > li + li,
  .body > .pair + .pair {
    position: relative;
    margin-top: 3.5rem;
    margin-inline: calc(-1 * var(--pad));
    padding-inline: var(--pad);
    padding-top: 3.5rem;
    border-top: 1px solid var(--twin-rule);
  }

  /* Header */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.1rem;
  }

  .nav nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.8125rem;
  }

  .nav nav a {
    text-decoration: none;
    color: var(--twin-text-muted);
  }

  .nav nav a:hover {
    color: var(--twin-text);
  }

  /* The wordmark: dot-matrix letters and a prompt cursor. */
  .logo {
    font: 900 1.9rem/1 var(--twin-font-mark);
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .cursor {
    display: inline-block;
    width: 0.3em;
    height: 0.5em;
    margin-left: 0.12em;
    background: var(--twin-fail);
    animation: blink 1.2s steps(1, end) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* Type: Doto for headings, JetBrains Mono for everything else. */
  h1,
  h2,
  h3 {
    margin: 0;
    font-family: var(--twin-font-mark);
    font-weight: 900;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  h1 {
    font-size: clamp(2.1rem, 3.6vw, 3rem);
    line-height: 1.12;
    letter-spacing: -0.04em;
  }

  h2 {
    font-size: clamp(1.5rem, 2.3vw, 1.95rem);
    line-height: 1.25;
    margin-bottom: 1.75rem;
  }

  h3 {
    font-size: 1.2rem;
    line-height: 1.35;
    margin-bottom: 1rem;
  }

  p {
    margin: 0 0 1.5rem;
    max-width: 72ch;
  }

  .lede,
  .intro {
    color: var(--twin-text-muted);
    font-size: 0.9375rem;
    max-width: 68ch;
  }

  .small {
    font-size: 0.8125rem;
    color: var(--twin-text-muted);
  }

  .kicker,
  .rail p,
  .step-no {
    font: 500 0.72rem/1.4 var(--twin-font-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--twin-text-muted);
  }

  code {
    font-family: var(--twin-font-mono);
    font-size: 0.92em;
  }

  :not(pre) > code {
    padding: 0.05em 0.3em;
    background: var(--twin-code);
    border: 1px solid var(--twin-rule);
  }

  figcaption code,
  dt code {
    padding: 0;
    background: none;
    border: 0;
  }

  /* Hero */
  .hero {
    display: grid;
    gap: 4rem;
    padding-block: 7rem;
  }

  .hero-text > * + * {
    margin-top: 2rem;
  }

  .hero-text .lede {
    margin-bottom: 0;
  }

  .kicker {
    margin: 0;
  }

  .install {
    position: relative;
    max-width: 38rem;
  }

  .install pre {
    margin: 0;
    padding: 0.8rem 5.5rem 0.8rem 1rem;
    background: var(--twin-surface);
    border: 1px solid var(--twin-rule);
    font-size: 0.8125rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .copy {
    position: absolute;
    top: 50%;
    right: 0.6rem;
    transform: translateY(-50%);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-bottom: 0;
    font-size: 0.875rem;
  }

  .button {
    display: inline-block;
    padding: 0.6rem 1.1rem;
    background: var(--twin-text);
    color: var(--twin-bg);
    font-weight: 500;
    text-decoration: none;
  }

  .button:hover {
    opacity: 0.88;
  }

  /* Sections: a label rail and a body, split by a rule on wide screens. */
  .sec {
    display: grid;
    gap: 1.5rem;
    padding-block: 7rem;
  }

  .rail p {
    margin: 0;
  }

  .rail span {
    color: var(--twin-text);
    margin-right: 0.5em;
  }

  .body > :last-child {
    margin-bottom: 0;
  }

  .pair {
    display: grid;
    gap: 2rem 5rem;
    align-items: start;
  }

  .pair-text > :last-child {
    margin-bottom: 0;
  }

  .stack {
    display: grid;
    gap: 2.5rem;
    min-width: 0;
  }

  @media (min-width: 64rem) {
    .pair {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    }

    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
      align-items: stretch;
      gap: 0;
      padding: 0;
    }

    .hero-text,
    .hero-demo {
      padding: 7rem var(--pad);
    }

    .hero-text {
      align-self: center;
    }

    .hero-demo {
      display: flex;
      align-items: center;
    }

    .hero-demo > .film {
      flex: 1;
    }

    .hero .split {
      border-left: 1px solid var(--twin-rule);
    }
  }

  @media (min-width: 80rem) {
    .sec {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: 0;
      padding: 0;
    }

    .rail {
      padding: 6rem 2rem;
    }

    .rail p {
      position: sticky;
      top: 1.5rem;
      padding-top: 0.55rem;
    }

    .sec > .body {
      padding: 6rem var(--pad);
      border-left: 1px solid var(--twin-rule);
    }
  }

  /* The demo film: the site's own controls, square and hairline, in place of the browser's. */
  .film {
    position: relative;
    margin: 0;
    border: 1px solid var(--twin-rule);
    background: var(--twin-code);
  }

  .film video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background: #111214;
    cursor: pointer;
  }

  .film:fullscreen {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .film:fullscreen video {
    height: calc(100% - 2.75rem);
    aspect-ratio: auto;
    object-fit: contain;
  }

  .film-big {
    position: absolute;
    bottom: calc(2.75rem + 1rem);
    right: 1rem;
    padding: 0.7rem 1.4rem;
    background: var(--twin-text);
    color: var(--twin-bg);
    border: 0;
    font: 500 0.8125rem/1.4 var(--twin-font-mono);
    cursor: pointer;
  }

  .film-big:hover {
    opacity: 0.88;
  }

  .film[data-state='playing'] .film-big {
    display: none;
  }

  .film-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 2.75rem;
    padding-inline: 0.75rem;
    border-top: 1px solid var(--twin-rule);
    font: 500 0.75rem/1 var(--twin-font-mono);
    color: var(--twin-text-muted);
  }

  .film-bar button {
    padding: 0.3rem 0.5rem;
    background: none;
    border: 1px solid transparent;
    color: var(--twin-text);
    font: inherit;
    cursor: pointer;
  }

  .film-bar button:hover {
    border-color: var(--twin-rule);
  }

  .film-toggle {
    min-width: 4.2em;
  }

  .film-mute {
    min-width: 6.5em;
  }

  .film-time {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .film-seek {
    --done: 0%;
    flex: 1;
    min-width: 0;
    height: 1rem;
    margin: 0;
    background: transparent;
    appearance: none;
    cursor: pointer;
  }

  .film-seek::-webkit-slider-runnable-track {
    height: 2px;
    background: linear-gradient(to right, var(--twin-text) var(--done), var(--twin-rule) var(--done));
  }

  .film-seek::-moz-range-track {
    height: 2px;
    background: var(--twin-rule);
  }

  .film-seek::-moz-range-progress {
    height: 2px;
    background: var(--twin-text);
  }

  .film-seek::-webkit-slider-thumb {
    width: 0.6rem;
    height: 0.9rem;
    margin-top: -0.4rem;
    background: var(--twin-text);
    border: 0;
    border-radius: 0;
    appearance: none;
  }

  .film-seek::-moz-range-thumb {
    width: 0.6rem;
    height: 0.9rem;
    background: var(--twin-text);
    border: 0;
    border-radius: 0;
  }

  @media (max-width: 40rem) {
    .film-big,
    .film-mute,
    .film-time {
      display: none;
    }
  }

  /* Command snippets: square and hairline. */
  .term {
    margin: 0;
    min-width: 0;
    background: var(--twin-code);
    border: 1px solid var(--twin-rule);
  }

  .term figcaption {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.4rem 1rem;
    background: var(--twin-code-head);
    border-bottom: 1px solid var(--twin-rule);
    font: 500 0.75rem/1.4 var(--twin-font-mono);
    color: var(--twin-text-muted);
  }

  .term figcaption code {
    padding: 0;
    background: none;
    border: 0;
    color: var(--twin-text);
    font-size: inherit;
  }

  .term pre {
    margin: 0;
    padding: 1rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font: 400 0.78rem/1.6 var(--twin-font-mono);
  }

  .term pre code {
    font-size: inherit;
  }

  .t-dim {
    color: var(--twin-text-muted);
  }

  .flow {
    list-style: none;
    display: grid;
    gap: 1.5rem;
    margin: 2rem 0 1.5rem;
