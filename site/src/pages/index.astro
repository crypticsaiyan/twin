---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/doto/900.css';
import '../styles/tokens.css';
import bisectLog from '../../../examples/echarts-21538/bisect.txt?raw';
import mcpLog from '../../../examples/echarts-21538/mcp.txt?raw';
import replayLog from '../../../examples/echarts-21538/replay.txt?raw';
import verifyLog from '../../../examples/echarts-21538/verify.txt?raw';
import { EXAMPLE, ISSUE, link, REPO, SOLARI } from '../site';

const title = 'twin';
const description =
  'twin records the environment a command failed in, rebuilds it on a clean Solari sandbox, finds the difference that causes the failure, and checks a fix there.';
const canonical = new URL(link(''), Astro.site).href;
const install = 'npx github:crypticsaiyan/twin capture -- npm test';

const docs = {
  intro: link('start/introduction/'),
  quickstart: link('start/quickstart/'),
  cli: link('reference/cli/'),
  agents: link('guides/ai-agents/'),
  action: link('guides/github-action/'),
  privacy: link('reference/privacy/'),
  limits: link('reference/limits/'),
  solari: link('reference/solari/'),
  caseStudy: link('examples/echarts-21538/'),
};

const escape = (text: string) =>
  text.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');

/** Semantic color for recorded output: failures red, passes green, prompts and timings dim. */
function paint(text: string): string {
  return text
    .trimEnd()
    .split('\n')
    .map((line) => {
      let html = escape(line);
      if (/^(\$|&gt;&gt;&gt;) /.test(html)) return `<span class="t-cmd">${html}</span>`;
      if (/^(&lt;&lt;&lt;|\s+\.\.\. )/.test(html)) return `<span class="t-dim">${html}</span>`;
      html = html
        .replace(/^(REPRODUCED|STILL FAILING)(:.*)$/, '<span class="t-bad t-strong">$1</span>$2')
        .replace(/^(FIXED)(:.*)$/, '<span class="t-good t-strong">$1</span>$2')
        .replaceAll('✓', '<span class="t-good">✓</span>')
        .replaceAll('✕', '<span class="t-bad">✕</span>')
        .replace(/\b(FAIL)\b/g, '<span class="t-bad">$1</span>')
        .replace(/\b(PASS|pass)\b/g, '<span class="t-good">$1</span>');
      return html;
    })
    .join('\n');
}

/** Sandbox ids run to ~190 characters; the page shows their start. */
const shortenIds = (text: string) =>
  text.replace(/\b([A-Za-z0-9_-]{16})[A-Za-z0-9_.-]{40,}/g, '$1…');
const lines = (text: string) => text.split('\n');
const lineStarting = (text: string, prefix: string) =>
  lines(text).find((line) => line.startsWith(prefix)) ?? '';

// Hero: the three verdicts, verbatim from the recorded runs.
const bisectResult = lines(bisectLog);
const minimalAt = bisectResult.findIndex((line) => line.startsWith('Minimal failing difference'));
const heroLog = [
  '$ twin replay new-york.json',
  lineStarting(replayLog, 'REPRODUCED'),
  '',
  '$ twin bisect new-york.json --good kolkata.json',
  ...bisectResult.slice(minimalAt, minimalAt + 2),
  '',
  '$ twin verify new-york.json --patch fix.patch',
  lineStarting(verifyLog, 'FIXED'),
].join('\n');

// The reporter's capsule, as `inspect` summarizes it (from the recorded agent session).
const summary = lines(mcpLog.slice(0, mcpLog.indexOf('>>> replay')));
const captureLog = summary
  .filter((line) =>
    /^ {2}(argv|result|time zone)\b|^ {13}(Expected|Received):|^ {2}(node|npm) {2,}|^ {2}commit /.test(
      line,
    ),
  )
  .join('\n');

// The agent session, trimmed to the calls and the lines that matter.
const agentLog = lines(shortenIds(mcpLog.slice(mcpLog.indexOf('>>> replay'))))
  .filter(
    (line) =>
      /^(>>>|<<<) /.test(line) ||
      /^(REPRODUCED|FIXED):|^ {2}machine |^TZ=|✕ roundTime_locale|✓ roundTime_locale|^Tests:|^wrote |^released /.test(
        line,
      ),
  )
  .join('\n');

const synopsis = [
  ['capture -- <command>', 'Run the command and record the environment it failed in.'],
  ['inspect <capsule> [<other>]', 'Summarize a capsule, or list every difference between two.'],
  ['replay <capsule> [--keep]', 'Rebuild it on a clean Solari sandbox and rerun the command.'],
  ['bisect <bad> --good <good>', 'Find the smallest difference that makes it fail.'],
  ['verify <capsule> --patch <file>', 'Check a fix in the reporter’s environment.'],
  ['shell [machine] [--web]', 'Open a terminal on a kept machine, or share one in a browser.'],
  ['mcp', 'Serve all of the above to a coding agent.'],
];

const steps = [
  {
    title: 'The reporter captures the failure',
    text: 'twin runs the command as usual and records what it ran in: OS, runtimes, package manager and lockfile hash, installed versions, commit and diff, time zone, environment variable names, and a fingerprint of the failure. Secrets are scrubbed, and the reporter reviews the file before it is written.',
    command: 'twin inspect new-york.json',
    time: null,
    log: captureLog,
  },
  {
    title: 'The maintainer replays it',
    text: 'Same Node, same npm, the exact commit fetched by SHA, npm ci from the lockfile, and the reporter’s time zone. Each attempt is compared with the failure recorded in the capsule.',
    command: 'twin replay new-york.json',
    time: '72 s',
    log: replayLog,
  },
  {
    title: 'Bisect finds the cause',
    text: 'Given a capsule from a machine where the test passes, twin builds that environment, confirms it passes, and applies the differences until the smallest set that fails is left.',
    command: 'twin bisect new-york.json --good kolkata.json',
    time: '69 s',
    log: bisectLog,
  },
  {
    title: 'Verify checks the fix where it failed',
    text: 'The patch goes onto a fresh copy of the reporter’s environment, so nothing is pushed first. This run was recorded before verify had its own report header, so it prints “Replay”.',
    command: 'twin verify new-york.json --patch fix.patch',
    time: '71 s',
    log: verifyLog,
  },
];

const seeAlso = [
  ['envinfo', 'Prints versions as text.', 'A capsule can be replayed, diffed and bisected.'],
  ['Dev containers, Nix', 'Give contributors the maintainer’s environment.', 'twin rebuilds the reporter’s.'],
  ['git bisect', 'Finds the commit that broke something.', 'twin finds the environment difference at a fixed commit.'],
  ['StackBlitz, CodeSandbox', 'Run minimal repros in a browser.', 'twin uses the reporter’s real commit, lockfile, env and time zone.'],
  ['wsp', 'Clones your own setup into cloud workspaces for your agents.', 'twin rebuilds a stranger’s failing environment from a scrubbed file.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={link('favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content="twin" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('starlight-theme');
        } catch {}
        if (stored === 'light' || stored === 'dark') document.documentElement.dataset.theme = stored;
      })();
    </script>
  </head>
  <body>
    <div class="page">
      <header class="nav">
        <a class="logo" href={link('')} aria-label="twin home">twin<span class="cursor" aria-hidden="true"></span></a>
        <nav aria-label="Site">
          <a href={docs.intro}>Docs</a>
          <a href={docs.caseStudy}>Case study</a>
          <a href={REPO}>GitHub</a>
          <button type="button" id="theme">Dark</button>
        </nav>
      </header>

      <main>
        <section class="hero">
          <div class="hero-text">
            <p class="kicker">For open source maintainers and coding agents</p>
            <h1>Reproduce the bug in the environment where it was reported.</h1>
            <p class="lede">
              Most “works on my machine” bugs aren’t in the code. They’re in a runtime version, a
              dependency the lockfile resolved differently, an environment variable, the time zone.
              twin records the environment a command failed in, rebuilds it on a clean
              <a href={SOLARI}>Solari</a> sandbox, finds the difference that causes the failure, and
              checks a fix there.
            </p>
            <div class="install">
              <pre><code><span class="t-dim">$</span> {install}</code></pre>
              <button type="button" class="copy" data-copy={install}>Copy</button>
            </div>
            <p class="actions">
              <a class="button" href={docs.quickstart}>Get started</a>
              <a href={docs.caseStudy}>Read the case study</a>
            </p>
          </div>
          <figure class="term hero-term">
            <figcaption>
              <span><a href={ISSUE}>apache/echarts#21538</a>, recorded on Solari</span>
            </figcaption>
            <pre><code set:html={paint(heroLog)} /></pre>
          </figure>
        </section>

        <section class="sec" aria-labelledby="commands">
          <p class="rail">Synopsis</p>
          <div class="body">
            <h2 id="commands">Seven commands, one file between them</h2>
            <dl class="synopsis">
              {
                synopsis.map(([cmd, what]) => (
                  <div>
                    <dt>
                      <code>twin {cmd}</code>
                    </dt>
                    <dd>{what}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="small">Every command has <code>--help</code>. <a href={docs.cli}>Full reference</a></p>
          </div>
        </section>

        <section class="sec" id="example" aria-labelledby="example-title">
          <p class="rail">Example</p>
          <div class="body">
            <h2 id="example-title">A real bug, start to finish</h2>
            <p class="intro">
              <a href={ISSUE}>apache/echarts#21538</a> is an open issue: a date test fails in time zones
              with daylight saving time and passes everywhere else, so a maintainer in Kolkata can’t see
              it. The output below is copied from the <a href={EXAMPLE}>recorded runs</a>.
            </p>
            <ol class="steps">
              {
                steps.map((step, index) => (
                  <li class="pair">
                    <div>
                      <p class="step-no">Step {index + 1}</p>
                      <h3>{step.title}</h3>
                      <p>{step.text}</p>
                    </div>
                    <figure class="term">
                      <figcaption>
                        <code>$ {step.command}</code>
                        {step.time && <span class="time">{step.time}</span>}
                      </figcaption>
                      <pre><code set:html={paint(step.log)} /></pre>
                    </figure>
                  </li>
                ))
              }
            </ol>
          </div>
        </section>

        <section class="sec" aria-labelledby="agents">
          <p class="rail">Agents</p>
          <div class="body">
            <h2 id="agents">Give coding agents the reporter’s machine</h2>
            <div class="pair">
              <div>
                <p>
                  An agent asked to fix #21538 runs the tests on its own machine, they pass, and it has
                  nothing to work with. twin’s MCP server lets it replay the failure, run commands in the
                  kept machine with the reporter’s env, PATH, time zone and working directory, try a
                  change, and verify the final diff on a fresh machine.
                </p>
                <p class="small">
                  Tools: inspect, replay, run, write_file, verify, bisect, release. <a href={docs.agents}>Agent guide</a>
                </p>
              </div>
              <div class="stack">
                <figure class="term">
                  <figcaption><span>Add to Claude Code</span></figcaption>
                  <pre><code><span class="t-dim">$</span> claude mcp add twin -e SOLARI_API_KEY=slr_live_... -- npx -y github:crypticsaiyan/twin mcp</code></pre>
                </figure>
                <figure class="term">
                  <figcaption>
                    <span>Recorded session, scripted client, ids shortened</span>
                    <span class="time">162 s</span>
                  </figcaption>
                  <pre><code set:html={paint(agentLog)} /></pre>
                </figure>
              </div>
            </div>
            <div class="pair">
              <div>
                <h3>Check the pull request where the bug happens</h3>
                <p>
                  The GitHub Action finds the capsule on the issue a pull request closes, verifies the
                  head commit in the reporter’s environment, and comments the verdict. The check fails
                  unless the bug is fixed.
                </p>
                <p class="small"><a href={docs.action}>Action reference</a></p>
              </div>
              <figure class="term">
                <figcaption><code>.github/workflows/twin.yml</code></figcaption>
                <pre><code>{`on: pull_request
jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: crypticsaiyan/twin@main
        with:
          solari-api-key: \${{ secrets.SOLARI_API_KEY }}`}</code></pre>
              </figure>
            </div>
          </div>
        </section>

        <section class="sec" aria-labelledby="files">
          <p class="rail">Files</p>
          <div class="body">
            <h2 id="files">What a capsule holds</h2>
            <p class="intro">
              <code>twin-capsule.json</code> is a few kilobytes, attached to the issue by the reporter.
              They see a summary, and the full JSON if they want, before anything is written.
            </p>
            <div class="cols">
              <div>
                <h3>Recorded</h3>
                <ul>
                  <li>OS, libc and architecture</li>
                  <li>Runtime and package manager versions, lockfile hashes</li>
                  <li>Installed Node and Python package versions</li>
                  <li>Remote, commit, branch and <code>git diff HEAD</code></li>
                  <li>Time zone and locale</li>
                  <li>Values of <code>TZ</code>, <code>NODE_ENV</code>, <code>LANG</code>, <code>CI</code> and a few more</li>
                  <li>Exit status, output tail and a failure fingerprint</li>
                </ul>
              </div>
              <div>
                <h3>Never recorded</h3>
                <ul>
                  <li>Other environment values: names only</li>
                  <li>Tokens, keys and passwords: replaced by pattern and entropy rules</li>
                  <li>Home directory paths: rewritten to <code>~</code></li>
                  <li>Contents of untracked files: names only</li>
                </ul>
                <p class="small"><a href={docs.privacy}>Privacy and redaction</a></p>
              </div>
            </div>
          </div>
        </section>

        <section class="sec" aria-labelledby="see-also">
          <p class="rail">See also</p>
          <div class="body">
            <h2 id="see-also">Where it fits</h2>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr><th>Tool</th><th>What it does</th><th>What twin adds</th></tr>
                </thead>
                <tbody>
                  {
                    seeAlso.map(([name, does, adds]) => (
                      <tr>
                        <td>{name}</td>
                        <td>{does}</td>
                        <td>{adds}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <section class="sec" aria-labelledby="limits">
          <p class="rail">Bugs</p>
          <div class="body">
            <h2 id="limits">Limits</h2>
            <p>
              Replay runs on Linux only. A macOS or Windows capsule is replayed with the same versions on
              Linux, and if it passes there, that points at the OS. Bisect varies env values, time zone,
              Node version, npm dependency versions and the working-tree diff.
              <a href={docs.limits}>All limits</a>
            </p>
            <p>
              Each run gets its own Solari sandbox, streamed with a real timeout and released with a
              confirmed kill. At about $0.125 per sandbox-hour, the runs above cost a fraction of a cent
              each. Building twin also turned up <a href={docs.solari}>platform behavior worth knowing</a>.
            </p>
          </div>
        </section>
      </main>

      <footer>
        <span class="logo small-logo">twin</span>
        <span>MIT license</span>
        <a href={REPO}>GitHub</a>
        <a href={docs.intro}>Docs</a>
      </footer>
    </div>

    <script>
      const root = document.documentElement;
      const toggle = document.getElementById('theme') as HTMLButtonElement;
      const isDark = () =>
        root.dataset.theme === 'dark' ||
        (!root.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
      const label = () => {
        toggle.textContent = isDark() ? 'Light' : 'Dark';
        toggle.setAttribute('aria-label', isDark() ? 'Switch to light theme' : 'Switch to dark theme');
      };
      label();
      toggle.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {}
        label();
      });
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', label);
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? '');
            button.textContent = 'Copied';
          } catch {
            const code = button.previousElementSibling;
            if (code) window.getSelection()?.selectAllChildren(code);
            button.textContent = 'Selected';
          }
          setTimeout(() => (button.textContent = 'Copy'), 1500);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    background: var(--twin-bg);
    scrollbar-color: var(--twin-rule) transparent;
  }

  pre {
    scrollbar-color: var(--twin-rule) transparent;
  }

  body {
    margin: 0;
    background: var(--twin-bg);
    color: var(--twin-text);
    font: 400 1rem/1.65 var(--twin-font-body);
    -webkit-font-smoothing: antialiased;
  }

  .page {
    max-width: 80rem;
    margin: 0 auto;
    padding-inline: clamp(1rem, 4vw, 3rem);
  }

  a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  :focus-visible {
    outline: 2px solid var(--twin-focus);
    outline-offset: 2px;
    border-radius: 4px;
  }

  button {
    font: 500 0.875rem var(--twin-font-body);
    color: var(--twin-text-muted);
    background: transparent;
    border: 1px solid var(--twin-rule);
    border-radius: 6px;
    padding: 0.3rem 0.7rem;
    cursor: pointer;
  }

  button:hover {
    color: var(--twin-text);
    border-color: var(--twin-text-muted);
  }

  /* Header */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--twin-rule);
  }

  .nav nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.9rem;
  }

  .nav nav a {
    text-decoration: none;
    color: var(--twin-text-muted);
  }

  .nav nav a:hover {
    color: var(--twin-text);
  }

  /* The wordmark: dot-matrix letters and a prompt cursor, the only pixel type besides labels. */
  .logo {
    font: 900 1.9rem/1 var(--twin-font-mark);
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .cursor {
    display: inline-block;
    width: 0.3em;
    height: 0.5em;
    margin-left: 0.12em;
    background: var(--twin-fail);
    animation: blink 1.2s steps(1, end) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  /* Type */
  h1,
  h2,
  h3 {
    margin: 0;
    font-weight: 600;
    text-wrap: balance;
  }

  h1 {
    font-size: clamp(2.2rem, 4.2vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  h2 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.025em;
    margin-bottom: 1rem;
  }

  h3 {
    font-size: 1.075rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
    margin-bottom: 0.5rem;
  }

  p {
    margin: 0 0 1rem;
  }

  .lede,
  .intro {
    color: var(--twin-text-muted);
    font-size: 1.075rem;
    max-width: 38rem;
  }

  .small {
    font-size: 0.875rem;
    color: var(--twin-text-muted);
  }

  .kicker,
  .rail,
  .step-no {
    font: 500 0.72rem/1.4 var(--twin-font-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--twin-text-muted);
  }

  code {
    font-family: var(--twin-font-mono);
    font-size: 0.9em;
  }

  :not(pre) > code {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--twin-code);
    border: 1px solid var(--twin-rule);
  }

  figcaption code,
  dt code {
    padding: 0;
    background: none;
    border: 0;
  }

  /* Layout */
  main {
    padding-bottom: 4rem;
  }

  .hero {
    display: grid;
    gap: 3rem;
    padding-block: 4.5rem 5rem;
  }

  .hero-text > * + * {
    margin-top: 1.25rem;
  }

  .hero-text .lede {
    margin-bottom: 0;
  }

  .kicker {
    margin: 0;
  }

  .install {
    position: relative;
    max-width: 36rem;
  }

  .install pre {
    margin: 0;
    padding: 0.85rem 5.5rem 0.85rem 1rem;
    background: var(--twin-surface);
    border: 1px solid var(--twin-rule);
    border-radius: 8px;
    font-size: 0.875rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .copy {
    position: absolute;
    top: 50%;
    right: 0.6rem;
    transform: translateY(-50%);
    padding: 0.2rem 0.6rem;
    font-size: 0.8rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-bottom: 0;
    font-size: 0.95rem;
  }

  .button {
    display: inline-block;
    padding: 0.6rem 1.1rem;
    border-radius: 8px;
    background: var(--twin-text);
    color: var(--twin-bg);
    font-weight: 500;
    text-decoration: none;
  }

  .button:hover {
    opacity: 0.88;
  }

  .sec {
    display: grid;
    gap: 0.75rem 3rem;
    padding-block: 4.5rem;
    border-top: 1px solid var(--twin-rule);
  }

  .rail {
    margin: 0;
  }

  .body > :last-child {
    margin-bottom: 0;
  }

  .pair {
    display: grid;
    gap: 1.25rem 3rem;
    align-items: start;
  }

  .pair + .pair {
    margin-top: 3.5rem;
  }

  .pair > div > :last-child {
    margin-bottom: 0;
  }

  .stack {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  @media (min-width: 64rem) {
    .pair {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    }

    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 4rem;
