---
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/doto/900.css';
import '../styles/tokens.css';
import kolkataCapsule from '../../../examples/echarts-21538/kolkata.json';
import newYorkCapsule from '../../../examples/echarts-21538/new-york.json';
import bisectLog from '../../../examples/echarts-21538/bisect.txt?raw';
import fixPatch from '../../../examples/echarts-21538/fix.patch?raw';
import mcpLog from '../../../examples/echarts-21538/mcp.txt?raw';
import replayLog from '../../../examples/echarts-21538/replay.txt?raw';
import verifyLog from '../../../examples/echarts-21538/verify.txt?raw';
import { EXAMPLE, ISSUE, link, REPO, SOLARI } from '../site';

const title = 'twin';
const description =
  'twin records the environment a command failed in, rebuilds it on a clean Solari sandbox, finds the difference that causes the failure, and checks a fix there.';
const canonical = new URL(link(''), Astro.site).href;
const install = 'npx @crypticsaiyan/twincli capture -- npm test';

const docs = {
  intro: link('start/introduction/'),
  quickstart: link('start/quickstart/'),
  cli: link('reference/cli/'),
  agents: link('guides/ai-agents/'),
  action: link('guides/github-action/'),
  privacy: link('reference/privacy/'),
  limits: link('reference/limits/'),
  solari: link('reference/solari/'),
  caseStudy: link('examples/echarts-21538/'),
};

const escape = (text: string) =>
  text.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');

/** Semantic color for recorded output: failures red, passes green, prompts and timings dim. */
function paint(text: string): string {
  return text
    .trimEnd()
    .split('\n')
    .map((line) => {
      let html = escape(line);
      if (/^(\$|&gt;&gt;&gt;) /.test(html)) return `<span class="t-cmd">${html}</span>`;
      if (/^(&lt;&lt;&lt;|\s+\.\.\. )/.test(html)) return `<span class="t-dim">${html}</span>`;
      html = html
        .replace(/^(REPRODUCED|STILL FAILING)(:.*)$/, '<span class="t-bad t-strong">$1</span>$2')
        .replace(/^(FIXED)(:.*)$/, '<span class="t-good t-strong">$1</span>$2')
        .replaceAll('✓', '<span class="t-good">✓</span>')
        .replaceAll('✕', '<span class="t-bad">✕</span>')
        .replace(/\b(FAIL)\b/g, '<span class="t-bad">$1</span>')
        .replace(/\b(PASS|pass)\b/g, '<span class="t-good">$1</span>');
      return html;
    })
    .join('\n');
}

/** Sandbox ids run to ~190 characters; the page shows their start. */
const shortenIds = (text: string) =>
  text.replace(/\b([A-Za-z0-9_-]{16})[A-Za-z0-9_.-]{40,}/g, '$1…');
const lines = (text: string) => text.split('\n');
const lineStarting = (text: string, prefix: string) =>
  lines(text).find((line) => line.startsWith(prefix)) ?? '';

/**
 * One line of a terminal on this page. The server renders every line in its final state;
 * the script only uses the data attributes to play it back (see src/scripts/demos.ts).
 * `pending` is what the line shows while its step runs, `seconds` the recorded duration.
 */
type Line = {
  html: string;
  type?: string;
  pending?: string;
  seconds?: number;
  verdict?: boolean;
  stage?: number;
  ref?: string;
};

const blank = (stage?: number): Line => ({ html: ' ', stage });
const command = (text: string, stage?: number): Line => ({ html: paint(text), type: text, stage });

/** A recorded report, split so step and attempt lines can be shown running, then done. */
function report(log: string): Line[] {
  return lines(log.trimEnd()).map((raw) => {
    if (!raw.trim()) return blank();
    const step = raw.match(/^ {2}✓ (.+?) {2}([\d.]+)s$/);
    if (step) {
      const ref = /candidate fix/.test(step[1]) ? step[1].split(' ')[0] : undefined;
      return { html: paint(raw), pending: escape(`  … ${step[1]}`), seconds: Number(step[2]), ref };
    }
    const attempt = raw.match(/^ {2}(\d+) {2}(?:FAIL|PASS).* {2}([\d.]+)s$/);
    if (attempt) {
      return { html: paint(raw), pending: escape(`  ${attempt[1]}  …`), seconds: Number(attempt[2]) };
    }
    return { html: paint(raw), verdict: /^(REPRODUCED|FIXED|STILL FAILING):/.test(raw) };
  });
}

// Hero: the three verdicts, verbatim from the recorded runs.
const bisectResult = lines(bisectLog);
const minimalAt = bisectResult.findIndex((line) => line.startsWith('Minimal failing difference'));
const heroLines: Line[] = [
  command('$ twin replay new-york.json'),
  { html: paint(lineStarting(replayLog, 'REPRODUCED')), verdict: true },
  blank(),
  command('$ twin bisect new-york.json --good kolkata.json'),
  ...bisectResult.slice(minimalAt, minimalAt + 2).map((raw) => ({ html: paint(raw) })),
  blank(),
  command('$ twin verify new-york.json --patch fix.patch'),
  { html: paint(lineStarting(verifyLog, 'FIXED')), verdict: true },
];

// Step 1, capture: the reporter's capsule, field by field, straight from new-york.json.
type EnvEntry = { state: string; value?: string };
const ny = newYorkCapsule as typeof newYorkCapsule & { env: Record<string, EnvEntry> };
const good = kolkataCapsule as typeof kolkataCapsule & { env: Record<string, EnvEntry> };
const lockfile = ny.packageManagers[0];
const envList = Object.entries(ny.env);
const envKept = envList.filter(([, entry]) => entry.state === 'set' && entry.value !== undefined);
const envNamed = envList.filter(([, entry]) => entry.state === 'set' && entry.value === undefined);
const envAbsent = envList.filter(([, entry]) => entry.state === 'absent').map(([name]) => name);
const packageCount = Object.keys(ny.resolved.node).length;

const capsule: { group: string; rows: [string, string, string?][] }[] = [
  {
    group: 'command',
    rows: [
      ['argv', ny.command.argv.join(' ')],
      ['outcome', `${ny.command.outcome}, exit ${ny.command.exitCode}, ${ny.command.durationMs} ms`],
      ['signature', ny.command.failure?.signature ?? ''],
    ],
  },
  {
    group: 'system',
    rows: [
      ['os', `${ny.os.platform} ${ny.os.arch}, ${ny.os.distro}, ${ny.os.libc} ${ny.os.libcVersion}`],
      ['time zone', `${ny.locale.timeZone}, ${ny.locale.locale}`],
    ],
  },
  {
    group: 'toolchain',
    rows: [
      ['node', ny.runtimes.node],
      [lockfile.name, `${lockfile.version}, ${lockfile.lockfile}`],
      ['lockfile', `sha256 ${lockfile.lockfileSha256.slice(0, 16)}…`],
      ['packages', `${packageCount} installed, versions recorded`],
    ],
  },
  {
    group: 'repository',
    rows: [
      ['remote', ny.repo.remote.replace(/^https:\/\//, '')],
      ['commit', `${ny.repo.commit.slice(0, 12)} on ${ny.repo.branch}`],
      [
        'diff',
        `${ny.repo.dirty ? 'uncommitted changes' : 'clean'}, ${ny.repo.untracked.length || 'no'} untracked`,
      ],
    ],
  },
  {
    group: 'environment',
    rows: [
      ...envKept.map(([name, entry]): [string, string, string] => [name, entry.value ?? '', 'value recorded']),
      ...envNamed.map(([name]): [string, string, string] => [name, 'set', 'name only']),
      [
        `${envAbsent.length} more`,
        `${envAbsent.filter((name) => /^(CI|NODE_ENV|NODE_OPTIONS)$/.test(name)).join(', ')}, …`,
        'not set',
      ],
    ],
  },
];

// Step 3, bisect: what bisect varies, compared between the two capsules.
const describeDiff = (capsuleRepo: typeof ny.repo) =>
  capsuleRepo.dirty ? 'uncommitted changes' : 'clean';
const unset = (capsuleEnv: Record<string, EnvEntry>) =>
  Object.entries(capsuleEnv)
    .filter(([, entry]) => entry.state === 'absent')
    .map(([name]) => name)
    .join(',');
const bisectRows = [
  ['node', good.runtimes.node, ny.runtimes.node, good.runtimes.node === ny.runtimes.node],
  [
    'npm packages',
    `${Object.keys(good.resolved.node).length} installed`,
    `${packageCount} installed`,
    JSON.stringify(good.resolved) === JSON.stringify(ny.resolved),
  ],
  ['git diff', describeDiff(good.repo), describeDiff(ny.repo), good.repo.diff === ny.repo.diff],
  ...['LANG', 'TZ'].map((name) => [
    name,
    good.env[name]?.value ?? 'not set',
    ny.env[name]?.value ?? 'not set',
    good.env[name]?.value === ny.env[name]?.value,
  ]),
  [
    `${envAbsent.length} others`,
    'not set',
    'not set',
    unset(good.env) === unset(ny.env),
  ],
] as [string, string, string, boolean][];

/** The bisect transcript, in the four stages the demo steps through. */
function bisectStages(log: string): Line[] {
  let stage = 1;
  const out: Line[] = [command('$ twin bisect new-york.json --good kolkata.json', 0)];
  for (const raw of lines(log.trimEnd())) {
    if (raw.startsWith('Trials')) stage = 2;
    if (/^ +2 {2}/.test(raw)) stage = 3;
    if (raw.startsWith('Minimal failing')) stage = 4;
    const trial = raw.match(/^ +(\d+) {2}(?:pass|FAIL) /);
    out.push(
      raw.trim()
        ? {
            html: paint(raw),
            stage,
            pending: trial ? escape(`   ${trial[1]}  …`) : undefined,
            seconds: trial ? Number(raw.match(/([\d.]+)s$/)?.[1]) : undefined,
          }
        : blank(stage),
    );
  }
  // A blank line belongs to the stage of the line after it.
  for (let index = out.length - 2; index >= 0; index--) {
    if (out[index].html === ' ') out[index].stage = out[index + 1].stage;
  }
  return out;
}

// Step 4, verify: the candidate fix, as a short excerpt of fix.patch.
const patchLines = lines(fixPatch.trimEnd());
const patchFile = patchLines.find((line) => line.startsWith('+++ '))?.replace(/^\+\+\+ b\//, '') ?? '';
const patchAdded = patchLines.filter((line) => /^\+(?!\+\+)/.test(line)).length;
const patchRemoved = patchLines.filter((line) => /^-(?!--)/.test(line)).length;
const hunk = patchLines.slice(patchLines.findIndex((line) => line.startsWith('@@')) + 1);
const firstChange = hunk.findIndex((line) => /^[-+]/.test(line));
const changed = hunk.slice(firstChange, hunk.findIndex((line, index) => index > firstChange && /^ /.test(line)));
const indent = Math.min(...changed.map((line) => line.slice(1).match(/^ */)?.[0].length ?? 0));
const patchExcerpt = changed.map((line) => ({
  sign: line[0],
  text: line.slice(1 + indent),
}));

const steps = [
  {
    title: 'The reporter captures the failure',
    text: 'twin runs the command and records the environment: OS, runtimes, package manager, lockfile hash, installed versions, commit, diff, time zone, variable names and a fingerprint of the failure. A short list of variables keeps its value; the rest are names only. Secrets are scrubbed, and the reporter reviews the file before it is written.',
    demo: 'capture',
  },
  {
    title: 'The maintainer replays it',
    text: 'Same Node and npm, the exact commit, dependencies from the lockfile, the reporter’s time zone. Each attempt is compared with the recorded failure.',
    demo: 'replay',
    recording: 'replay.txt, recorded on Solari',
    command: 'twin replay new-york.json',
    time: '72 s',
    lines: [command('$ twin replay new-york.json'), ...report(replayLog)],
  },
  {
    title: 'Bisect finds the cause',
    text: 'Given a capsule where the test passes, twin builds that environment and applies the differences until the smallest set that fails is left.',
    demo: 'bisect',
    recording: 'bisect.txt, recorded on Solari',
    command: 'twin bisect new-york.json --good kolkata.json',
    time: '69 s',
    lines: bisectStages(bisectLog),
  },
  {
    title: 'Verify checks the fix where it failed',
    text: 'The patch goes onto a fresh copy of the reporter’s environment. Nothing has to be pushed first.',
    demo: 'verify',
    recording: 'verify.txt, recorded on Solari',
    command: 'twin verify new-york.json --patch fix.patch',
    time: '71 s',
    lines: [command('$ twin verify new-york.json --patch fix.patch'), ...report(verifyLog)],
  },
];

// The agent session: one entry per MCP tool call, with the recorded time each took.
const sessionSeconds = Number(mcpLog.match(/^session (\d+) s$/m)?.[1]);
const calls = mcpLog
  .split(/^>>> /m)
  .slice(1)
  .map((block) => {
    const body = lines(block.replace(/\nsession \d+ s\s*$/, '').trimEnd());
    const name = body[0].split(' ')[0];
    const doneAt = body.findIndex((line) => line.startsWith('<<< '));
    const seconds = Number(body[doneAt].match(/^<<< (\d+) s/)?.[1]);
    const output = body.slice(doneAt + 1);
    const key =
      [...output]
        .reverse()
        .find((line) => /^(REPRODUCED|FIXED):|^Tests:|^wrote |^released |^ {2}result /.test(line)) ?? '';
    return {
      name,
      seconds,
      key: paint(shortenIds(key.trim().replace(/ {2,}/g, ' '))),
      detail: paint(shortenIds(`>>> ${body.join('\n')}`)),
    };
  });
const callSeconds = calls.reduce((sum, call) => sum + call.seconds, 0);
const shownCall = calls.findIndex((call) => call.name === 'verify');
if (callSeconds !== sessionSeconds) {
  throw new Error(`mcp.txt: calls add up to ${callSeconds} s, the session says ${sessionSeconds} s`);
}

const synopsis = [
  ['capture -- <command>', 'Run the command and record the environment it failed in.'],
  ['inspect <capsule>', 'Summarize what a capsule recorded.'],
  ['diff <capsule> <other>', 'List every environment difference between two capsules.'],
  ['replay <capsule> [--keep]', 'Rebuild it on a clean Solari sandbox and rerun the command.'],
  ['bisect <bad> --good <good>', 'Find the smallest difference that makes it fail.'],
  ['verify <capsule> --patch <file>', 'Check a fix in the reporter’s environment.'],
  ['list', 'Show the machines twin has running.'],
  ['shell [machine] [--web]', 'Open a terminal on a kept machine, or share one in a browser.'],
  ['stop [machine]', 'Stop one kept machine, or all of them.'],
  ['mcp', 'Serve all of the above to a coding agent.'],
];

const seeAlso = [
  ['envinfo', 'Prints versions as text.', 'A capsule can be replayed, diffed and bisected.'],
  ['Dev containers, Nix', 'Give contributors the maintainer’s environment.', 'twin rebuilds the reporter’s.'],
  ['git bisect', 'Finds the commit that broke something.', 'twin finds the environment difference at a fixed commit.'],
  ['StackBlitz, CodeSandbox', 'Run minimal repros in a browser.', 'twin uses the reporter’s real commit, lockfile, env and time zone.'],
  ['wsp', 'Clones your own setup into cloud workspaces for your agents.', 'twin rebuilds a stranger’s failing environment from a scrubbed file.'],
];

/** Time zone names may wrap after their slash on a phone, never inside a word. */
const breakable = (text: string) => escape(text).replaceAll('/', '/<wbr>');

const lineClass = (line: Line) =>
  ['ln', line.html === ' ' && 'blank', line.type && 'typed', line.verdict && 'verdict'].filter(Boolean).join(' ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={link('favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content="twin" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let stored = null;
        try {
          stored = localStorage.getItem('starlight-theme');
        } catch {}
        if (stored === 'light' || stored === 'dark') root.dataset.theme = stored;
        // The hero terminal is in view on load, so it starts blank instead of flashing its
        // final state first. If the demo script has not taken over within 2.5 s, it shows as is.
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('hero-armed');
          setTimeout(() => root.classList.remove('hero-armed'), 2500);
        }
      })();
    </script>
  </head>
  <body>
    <header class="band band-nav">
      <div class="col nav">
        <a class="logo" href={link('')} aria-label="twin home">twin<span class="cursor" aria-hidden="true"></span></a>
        <nav aria-label="Site">
          <a href={docs.intro}>Docs</a>
          <a href={docs.caseStudy}>Case study</a>
          <a href={REPO}>GitHub</a>
          <button type="button" id="theme">Dark</button>
        </nav>
      </div>
    </header>

    <main>
      <section class="band">
        <div class="col hero">
          <div class="hero-text">
            <p class="kicker">For open source maintainers and coding agents</p>
            <h1>Reproduce the bug in the environment where it was reported.</h1>
            <p class="lede">
              twin records the environment a command failed in, rebuilds it on a clean
              <a href={SOLARI}>Solari</a> sandbox, finds the difference that causes the failure, and
              checks a fix there.
            </p>
            <div class="install">
              <pre><code><span class="t-dim">$</span> {install}</code></pre>
              <button type="button" class="copy" data-copy={install}>Copy</button>
            </div>
            <p class="actions">
              <a class="button" href={docs.quickstart}>Get started</a>
              <a href={docs.caseStudy}>Read the case study</a>
            </p>
          </div>
          <div class="hero-demo split">
            <figure class="term" data-demo="hero">
              <figcaption>
                <span><a href={ISSUE}>apache/echarts#21538</a>, recorded on Solari</span>
                <button type="button" class="again" hidden>Play again</button>
              </figcaption>
              <pre><code>{heroLines.map((line) => <span class={lineClass(line)} data-type={line.type} set:html={line.html} />)}</code></pre>
            </figure>
          </div>
        </div>
      </section>

      <section class="band" aria-labelledby="demo">
        <div class="col sec">
          <div class="rail"><p><span>01</span> Demo</p></div>
          <div class="body split">
            <h2 id="demo">See it work on a real bug</h2>
            <figure class="film">
              <video controls preload="none" playsinline poster={link('demo/twin-demo-poster.jpg')}>
                <source src={link('demo/twin-demo.mp4')} type="video/mp4" />
              </video>
            </figure>
            <p class="small">
              date-fns#2068: capture, replay, bisect, verify, a shared browser terminal and Claude Code,
              3.5 minutes.
            </p>
          </div>
        </div>
      </section>

      <section class="band" aria-labelledby="commands">
        <div class="col sec">
          <div class="rail"><p><span>02</span> Synopsis</p></div>
          <div class="body split">
            <h2 id="commands">Ten commands, one file between them</h2>
            <dl class="synopsis">
              {
                synopsis.map(([cmd, what]) => (
                  <div>
                    <dt>
                      <code>twin {cmd}</code>
                    </dt>
                    <dd>{what}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="small"><a href={docs.cli}>Full reference</a></p>
          </div>
        </div>
      </section>

      <section class="band" id="example" aria-labelledby="example-title">
        <div class="col sec">
          <div class="rail"><p><span>03</span> Example</p></div>
          <div class="body split">
            <h2 id="example-title">A real bug, start to finish</h2>
            <p class="intro">
              <a href={ISSUE}>apache/echarts#21538</a>: a date test fails in daylight-saving time zones,
              so a maintainer in Kolkata can’t see it. Everything below comes from the
              <a href={EXAMPLE}>capsules and recorded runs</a>, played back faster than they ran.
            </p>
            <ol class="steps">
              {
                steps.map((step, index) => (
                  <li class="pair">
                    <div class="pair-text">
                      <p class="step-no">Step {index + 1}</p>
                      <h3>{step.title}</h3>
                      <p>{step.text}</p>
                    </div>

                    {step.demo === 'capture' && (
                      <figure class="term" data-demo="capture">
                        <figcaption>
                          <code>new-york.json</code>
                          <span class="cap-meta">
                            <span class="time">{ny.generator}</span>
                            <button type="button" class="again" hidden>Play again</button>
                          </span>
                        </figcaption>
                        <div class="tabs" role="group" aria-label="Capsule sections">
                          {capsule.map(({ group }) => (
                            <button type="button" data-group={group} aria-pressed="false">
                              {group}
                            </button>
                          ))}
                        </div>
                        <dl class="capsule">
                          {capsule.map(({ group, rows }) =>
                            rows.map(([key, value, note], row) => (
                              <div class={row === 0 ? 'cap-row group-start' : 'cap-row'} data-group={group} data-note={note}>
                                <dt>{key}</dt>
                                <dd>
                                  <span class="cap-value">{value}</span>
                                  {note && <span class="cap-note">{note}</span>}
                                </dd>
                              </div>
                            )),
                          )}
                        </dl>
                      </figure>
                    )}

                    {step.demo === 'replay' && (
                      <figure class="term" data-demo="stream">
                        <figcaption>
                          <code>{step.recording}</code>
                          <span class="cap-meta">
                            <span class="time">{step.time}</span>
                            <button type="button" class="again" hidden>Play again</button>
                          </span>
                        </figcaption>
                        <pre><code>{step.lines?.map((line) => <span class={lineClass(line)} data-type={line.type} data-pending={line.pending} data-seconds={line.seconds} set:html={line.html} />)}</code></pre>
                      </figure>
                    )}

                    {step.demo === 'bisect' && (
                      <figure class="term" data-demo="bisect" data-stage="4">
                        <figcaption>
                          <code>{step.recording}</code>
                          <span class="cap-meta">
                            <span class="time">{step.time}</span>
                            <button type="button" class="again" hidden>Play again</button>
                          </span>
                        </figcaption>
                        <div class="tabs" role="group" aria-label="Bisect stages">
                          {['compare', 'trial 1', 'trial 2', 'result'].map((label, index) => (
                            <button type="button" data-stage={index + 1} aria-pressed={index === 3 ? 'true' : 'false'}>
                              <span class="tab-no">{index + 1}</span> {label}
                            </button>
                          ))}
                        </div>
                        <div class="table-scroll">
                          <table class="compare">
                            <thead>
                              <tr>
                                <th scope="col">varied by bisect</th>
                                <th scope="col">
                                  kolkata.json <span class="t-good">{good.command.outcome}</span>
                                </th>
                                <th scope="col">
                                  new-york.json <span class="t-bad">{ny.command.outcome.toUpperCase()}</span>
                                </th>
                              </tr>
                            </thead>
                            <tbody>
                              {bisectRows.map(([key, left, right, same]) => (
                                <tr class={same ? 'same' : 'differs'}>
                                  <th scope="row">
                                    <span class="rel" aria-hidden="true">{same ? '=' : '≠'}</span>
                                    {key}
                                  </th>
                                  <td data-t1 data-t2={same ? '' : undefined} set:html={breakable(left)} />
                                  <td data-t2={same ? undefined : ''} set:html={breakable(right)} />
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                        <pre><code>{step.lines?.map((line) => <span class={lineClass(line)} data-stage={line.stage} data-type={line.type} data-pending={line.pending} data-seconds={line.seconds} set:html={line.html} />)}</code></pre>
                      </figure>
                    )}

                    {step.demo === 'verify' && (
                      <figure class="term" data-demo="stream">
                        <figcaption>
                          <code>{step.recording}</code>
                          <span class="cap-meta">
                            <span class="time">{step.time}</span>
                            <button type="button" class="again" hidden>Play again</button>
                          </span>
                        </figcaption>
                        <div class="patch" data-state="applied">
                          <p class="patch-head">
                            <span>fix.patch</span>
                            <span class="patch-file">{patchFile}</span>
